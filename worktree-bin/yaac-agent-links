#!/bin/sh
# yaac agent-session discovery hook, shared by every tool that has a
# SessionStart hook and a host-mounted home. $1 is that home
# (~/.claude, ~/.codex); $2 is that home's name under the project
# directory (claude, codex, pi). The hook payload is on stdin.
#
# Staged per worktree like every other worktree-bin script: read-only File
# mount at /usr/local/bin/yaac-agent-links under the k8s driver, a symlink in
# the workspace's own bin dir under containerless. Both drivers put that dir
# on the agent's PATH, which is why the tools invoke it by bare name — no
# absolute path names it in both worlds. It is deliberately NOT copied into
# the mounted tool homes, which a session can rewrite.
#
# Appends ONE JSON line per firing to "$HOME"/.yaac/session-starts.jsonl,
# which the host mounts (or symlinks) and the herd folds into the worktree's
# metadata document. Append-only and never renamed, which is what makes it
# safe to share with a host-side writer: a single-line append needs no lock,
# where the document itself is rewritten whole and so is never mounted in
# here at all.
#
# The transcript is recorded RELATIVE TO THE PROJECT DIRECTORY, because the
# payload's path is the workspace's own (/home/yaac/.claude/... in a pod,
# <workspace home>/.claude/... on a host) and the herd reads the same file
# through the shared project dir, where that prefix does not exist. Swapping
# the home for its project-relative name is the whole translation, so it
# stays parameter expansion — no interpreter, and nothing to escape.
#
# Fires on startup/resume/clear/compact, so /clear and `claude --resume` are
# what add sessions and repoint a pane. Always exits 0: a broken write must
# never take the agent down with it.
HOME_DIR="$1"
HOME_NAME="$2"
INPUT=$(cat)
[ -n "$HOME_DIR" ] || exit 0
[ -n "$HOME_NAME" ] || exit 0
[ -n "${HOME:-}" ] || exit 0
TRANSCRIPT=$(echo "$INPUT" | sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
SID=$(echo "$INPUT" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
# codex names its rollout files after the session; if a tool ever omits
# session_id from the payload the transcript basename still identifies it.
[ -n "$SID" ] || SID=$(basename "${TRANSCRIPT:-}" .jsonl)
[ -n "$SID" ] || exit 0
# The home may be reached through a symlink — under containerless the tool
# home in the workspace's private HOME is a link to the project's shared one —
# and a tool that resolves its own paths then reports a transcript under the
# physical directory instead. Try both, so the project-relative form is found
# either way. `pwd -P` rather than `readlink -f`, which macOS lacked until
# recently and this driver runs there; it also covers macOS's own /var ->
# /private/var aliasing of a data dir.
PHYS=$(cd "$HOME_DIR" 2>/dev/null && pwd -P)
# A path outside this home has no project-relative form we can express, and
# one the payload omitted has none yet. Either way the field is empty rather
# than a path that resolves nowhere — the session is still real.
case "$TRANSCRIPT" in
  "$HOME_DIR"/*) REL="$HOME_NAME/${TRANSCRIPT#"$HOME_DIR"/}" ;;
  "${PHYS:-$HOME_DIR}"/*) REL="$HOME_NAME/${TRANSCRIPT#"${PHYS:-$HOME_DIR}"/}" ;;
  *) REL='' ;;
esac
# The line has to be valid JSON or the reader drops it, silently — this hook
# cannot report a failure. A backslash or a quote in a path is legal on every
# filesystem yaac runs on, so escape both rather than emit something that
# parses nowhere. The extraction above does NOT decode the payload's own JSON
# escapes (sed, not a parser), so such a path may still come out mangled; what
# this buys is that the SESSION is still recorded rather than the whole line
# being lost.
esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
# tmux exports TMUX_PANE into every pane, and hooks inherit the agent's env,
# so this is how a session is attributed to the pane running it. Strip the
# leading '%' so the value is a plain token.
mkdir -p "$HOME"/.yaac || exit 0
printf '{"id":"%s","tool":"%s","pane":"%s","path":"%s"}\n' \
  "$(esc "$SID")" "$HOME_NAME" "${TMUX_PANE#%}" "$(esc "$REL")" \
  >> "$HOME"/.yaac/session-starts.jsonl
exit 0
