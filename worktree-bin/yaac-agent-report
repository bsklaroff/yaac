#!/bin/sh
# yaac agent reporter: puts what an agent says about itself on its tmux pane,
# where the server's status watcher is subscribed over tmux control mode —
# the model as the pane option @yaac-model, and the permission mode it is in
# as @yaac-permission-mode. That subscription is the whole transport — tmux
# pushes the new value the moment it is set, so a model switch or a mode
# change reaches the worktree's row without anything reading a transcript.
#
# A caller that has the values in hand (a plugin or extension) passes them:
# $1 the model, $2 the mode, either of which may be empty. With no arguments
# they are read from a hook payload on stdin: claude's PostModelSwitch carries
# `to_model`, its SessionStart `model` — on an interactive startup, not on a
# CLI `--resume` — and its UserPromptSubmit and Stop `permission_mode`. A
# value the payload does not name leaves that option alone: a SessionStart
# for `/clear` changed no model, and the option belongs to the pane, so the
# conversation that now owns the pane inherits it.
#
# The mode is the tool's own word for it (claude's `acceptEdits`, opencode's
# `plan` agent); the server reads it as a posture. Anything in the workspace
# can set these options, which the server knows: it filters both where it
# subscribes, and never lets a mode read here raise the worktree above the
# posture a person chose for it (docs/permission-modes.md).
#
# Staged per worktree beside yaac-agent-links, and run by bare name for the
# same reason (see that script). The pane is $TMUX_PANE; the server is $TMUX,
# or $YAAC_TMUX for claude, which runs with $TMUX hidden (see buildAgentCmd).
#
# Prints NOTHING: claude hands a hook's stdout to the model. Always exits 0 —
# a failed report costs a stale label, never the agent.
if [ $# -gt 0 ]; then
  MODEL="${1:-}"
  MODE="${2:-}"
else
  # The payload is one line of JSON, and a quote inside a string field (the
  # prompt, the last message) is escaped — so only the real fields match.
  INPUT=$(cat)
  MODEL=$(printf '%s' "$INPUT" | sed -n 's/.*"to_model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  [ -n "$MODEL" ] \
    || MODEL=$(printf '%s' "$INPUT" | sed -n 's/.*"model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  MODE=$(printf '%s' "$INPUT" | sed -n 's/.*"permission_mode"[[:space:]]*:[[:space:]]*"\([A-Za-z-]*\)".*/\1/p')
fi
[ -n "$MODEL$MODE" ] || exit 0
[ -n "${TMUX_PANE:-}" ] || exit 0
SERVER="${TMUX:-${YAAC_TMUX:-}}"
[ -n "$SERVER" ] || exit 0
# $TMUX is `<socket>,<pid>,<session>`.
set_option() {
  tmux -S "${SERVER%%,*}" set-option -p -t "$TMUX_PANE" "$1" "$2" >/dev/null 2>&1
}
[ -z "$MODEL" ] || set_option @yaac-model "$MODEL"
[ -z "$MODE" ] || set_option @yaac-permission-mode "$MODE"
exit 0
