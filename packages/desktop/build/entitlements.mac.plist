<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!-- Hardened-runtime entitlements for the release build, applied to the
       Electron binaries and (via entitlementsInherit) every nested Mach-O —
       including the bundled standalone Node in Resources, whose V8 needs
       the same JIT allowances as Electron's. -->
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
