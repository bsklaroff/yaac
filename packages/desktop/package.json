{
  "name": "@yaac/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "imports": {
    "#*": "./src/*.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup && electron .",
    "dev:hot": "bash scripts/dev-hot.sh",
    "app:build": "tsup && electron-builder --config electron-builder.yml",
    "app:install": "pnpm app:build && tsx scripts/install-app.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yaac/auth-daemon": "workspace:*",
    "@yaac/shared": "workspace:*",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "tsup": "catalog:",
    "tsx": "catalog:"
  }
}
