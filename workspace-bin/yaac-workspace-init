#!/bin/sh
# yaac-workspace-init — the generic half of a workspace pod's setup, run as
# the workspace container's postStart hook, so the kubelet holds the pod's
# Ready until it is done. It prepares nothing of any one workspace: the
# server does that with one `claim` call to streamd once the pod is a
# workspace's (docs/generic-workspace-pods.md "A claim"), which writes
# the git identity and npm registry, restores opencode's history and opens
# the tmux session with the workspace's environment.
#
# Here: the running uid gets the image's `yaac` identity, the tmux server
# starts with no session, and streamd starts last, since its answering is
# the server's signal that this is done.
set -eu

# Give the running uid the image's `yaac` identity, before anything that
# depends on it.
#
# Workspace images are uid-agnostic (docs/arbitrary-uid-images.md) — the `yaac`
# user is a fixed uid 1000 — while the pod runs as the install host's uid.
# getpwuid() then has no answer for the running uid, and the things that ask
# do not degrade: ssh exits 255 ("No user exists for uid") rather than
# connecting, sudo stops matching the image's NOPASSWD line (which names the
# user, not the number), and `zsh`/`git`/node's os.userInfo() report a bare
# number. /etc/passwd is group-0 writable (see dockerfiles/Dockerfile.default)
# precisely so this can happen.
#
# Runs here rather than in the image ENTRYPOINT for two reasons: the kubelet
# orders a container's entrypoint and its postStart hook not at all, so the
# setup below could run before it; and staging it with the rest of
# workspace-bin makes it independent of which image a workspace runs,
# including a standalone project image with an entrypoint of its own. Same
# rewrite, same two rules as dockerfiles/server-entrypoint.sh:
#
#   REPLACE the entry, never append a second one. getpwnam("yaac") and
#   getpwuid(running uid) have to resolve to each other, or anything that
#   names `yaac` (`chown yaac`, `sudo -u yaac`) acts as uid 1000 instead of
#   as us.
#
#   Truncate in place rather than `sed -i`, which renames a temp file over
#   /etc/passwd and so needs write permission on /etc, which we lack.
#
# A no-op on a host whose uid is 1000. A failure to write is a warning, not a
# fatal: most of a workspace works without the entry, and the hook failing
# would fail the pod.
if [ "$(id -un 2>/dev/null)" != yaac ]; then
  if passwd_file=$(sed "s/^yaac:x:[0-9]*:[0-9]*:/yaac:x:$(id -u):$(id -g):/" /etc/passwd) \
    && printf '%s\n' "$passwd_file" > /etc/passwd
  then :; else
    echo "yaac: could not re-point the yaac passwd entry at uid $(id -u);" \
      "sudo and git over ssh will fail" >&2
  fi
fi

# Run from /, never the container's /workspace workingDir, which a claim
# fills while processes may already be running.
cd /

# Start the tmux server with no session: the claim opens one, at the
# workspace's cwd, once the environment is set (`exit-empty off` keeps the
# server up meanwhile).
#
# `env COLORTERM=truecolor` seeds the server's environment, which every pane
# inherits. TUIs decide whether to emit 24-bit color from COLORTERM; without
# it they see only TERM=tmux-256color and quantize their themes to the
# 256-color palette before the RGB passthrough below can help.
#
# history-limit is set before any pane: tmux fixes a pane's limit when the
# pane is created. Then the session UX options:
#  - monitor-bell/bell-action: propagate terminal bells (\a) from any window
#    through to the attached client so the user's emulator can surface
#    notifications.
#  - extended-keys on: forward CSI-u "extended keys" to any pane app that
#    opts in. The `on` mode negotiates per-app, so it can't regress classic
#    key encoding; agent TUIs use it to tell modified Enter apart from a
#    plain newline (pi warns at startup when it's off).
#  - default-terminal + terminal-features RGB: advertise 24-bit color so
#    tmux forwards RGB escapes to the attached terminal instead of
#    quantizing to the 256-color palette.
#  - escape-time 10: tmux holds a lone ESC this long to see whether it
#    starts a key sequence. The 500ms default delays every Esc press (how an
#    agent turn is interrupted); a sequence arrives in one write, so 10ms
#    still reassembles one a slow link splits.
#  - bind-key k: C-b k kills the whole tmux server, so it asks first.
# Keep the socket in sync with CONTAINER_TMUX_SOCK (packages/shared/src/paths.ts).
env COLORTERM=truecolor tmux -S /tmp/yaac-tmux/server -u start-server \; \
  set-option -s exit-empty off \; \
  set-option -g history-limit 200000 \; \
  set-option -s escape-time 10 \; \
  set-option -g mouse on \; \
  set-option -g focus-events on \; \
  set-option -g monitor-bell on \; \
  set-option -g bell-action any \; \
  set-option -g visual-bell off \; \
  set-option -g allow-passthrough on \; \
  set-option -g extended-keys on \; \
  set-option -g default-terminal tmux-256color \; \
  set-option -as terminal-features ',*:RGB' \; \
  bind-key k confirm-before -p 'kill this yaac session? (y/n)' kill-server

# streamd LAST: its reachability over the stream relay is the server's
# "in-pod setup done" signal, so anything the relay runs sees the tmux server
# above. It comes from this script's own helpers folder, so the two are
# always one build's. Idempotent (a second daemon exits on EADDRINUSE); the
# status watcher's self-heal re-runs the same command via kubectl exec if it
# ever dies (`bootStreamd`).
setsid /opt/yaac/helpers/daemons/streamd >>/tmp/streamd.log 2>&1 </dev/null &

exit 0
