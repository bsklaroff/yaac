#!/bin/sh
# Append what a tmux pane prints to a log file, set up by the hook each
# life sources (docs/workspace-steps.md "Logs"). At 64 MiB the file moves to
# `<file>.1`, replacing the one before, so a window that runs for days holds
# at most twice that.
#
# `head` writes straight to the file, so no other process reads a pipe it
# splices into. uutils' `head` moves its input with splice(2), and a process
# asleep on such a pipe can miss the wakeup and leave the pane's last output
# unread for good, since a dead pane kept on screen never closes the socket.
# With a file on stdout it splices through an internal pipe that it drains
# itself, which is safe.
#
# The writer stops at end of input, when a chunk adds nothing to the file.
# The size is read back from the file, so a log replaced, truncated or
# deleted while `head` runs, or a `head` killed early, does not end the
# logging. A log that cannot be opened at all does, so the writer never
# spins without reading its input.
#
# Usage: yaac-log-writer <file>
f=$1
cap=67108864
size=0
[ ! -f "$f" ] || size=$(wc -c < "$f")
while :; do
  if [ "$size" -ge "$cap" ]; then
    mv -f "$f" "$f.1"
    size=0
  fi
  { head -c $((cap - size)) || :; } >> "$f" || exit 0
  was=$size
  size=$(wc -c 2>/dev/null < "$f") || { size=0; continue; }
  [ "$size" -ne "$was" ] || exit 0
done
