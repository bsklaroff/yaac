#!/bin/sh
# yaac-mama — ask the yaac server that runs this workspace to do something.
#
# Usage:
#   yaac-mama list
#   yaac-mama create [opts] "<prompt>"
#   yaac-mama queue --parent-workspace W [opts] "<prompt>"
#   yaac-mama edit-queued [--parent-workspace W] [opts] <queued> ["<prompt>"]
#     where opts: [--tool T] [--model M] [--permission-mode P] [--ui-mode U]
#                 [--branch B] [--group G] [--title T]
#   yaac-mama rename [<workspace>] "<title>"
#   yaac-mama stop [<workspace>]
#   yaac-mama group create "<name>"
#   yaac-mama group move <workspace> ["<group>"]
#   yaac-mama models
#   yaac-mama fetch <workspace>
#   yaac-mama history <workspace> [<conversation>] [-o <dir>]
#
# A strict subset of the `yaac` CLI: see what this project is running, start
# another workspace, file workspaces into named groups, and stop one. Stopping is
# in reach because it is reversible — the checkout and the conversation
# survive it. Nothing here deletes, restarts or reconfigures anything; that
# stays with the user. `fetch` reads another workspace's branches into this
# checkout and `history` its conversations; neither writes to theirs.
#
# One request, a JSON envelope {command, args, body} POSTed to the server's
# /api/workspace/mama, which owns what the commands mean. The substrates
# differ only in how it gets there and how the caller is identified:
#
#   - Containerless ($YAAC_MAMA_URL set): the workspace is a host process
#     beside the server, so it calls the server itself and proves which
#     workspace it is with $YAAC_MAMA_TOKEN.
#   - Containers (no $YAAC_MAMA_URL): the pod cannot dial the server, so it
#     calls the egress proxy's magic host, which relays the call and names
#     the workspace by its source pod IP. No token and no config, which is
#     why nothing is set for this case. Keep the host in sync with
#     MAMA_MAGIC_HOST in k8s/proxy/main.ts.
#
# --max-time bounds a call to a wedged server. It outlasts the proxy's own
# deadline (MAMA_RELAY_TIMEOUT_MS), so a pod's caller sees that 504's message.
# A download gets longer, since a large history takes a while to stream.
set -u

URL=${YAAC_MAMA_URL:-http://yaac.internal}

usage() {
  cat <<'EOF'
yaac-mama — ask the yaac server running this workspace to do something.

Usage:
  yaac-mama list                                   # workspaces + groups here
  yaac-mama create [opts] "<prompt>"               # start another workspace
  yaac-mama queue --parent-workspace <id> [opts] "<prompt>"
                                                   # start one when <id> stops
  yaac-mama edit-queued [opts] <queued> ["<prompt>"]
                                                   # change a queued one
  yaac-mama rename [<workspace>] "<title>"          # retitle (default: yourself)
  yaac-mama stop [<workspace>]                      # stop it (default: yourself)
  yaac-mama group create "<name>"                  # make an empty group
  yaac-mama group move <workspace> ["<group>"]      # omit the group to ungroup
  yaac-mama models                                 # tools/models available
  yaac-mama fetch <workspace>                      # read its branches into git
  yaac-mama history <workspace>                    # list its conversations
  yaac-mama history <workspace> <conversation>     # print one's transcripts
  yaac-mama history <workspace> [<conversation>] -o <dir>
                                                   # save every file of one/all
  yaac-mama --help

Options for create, queue and edit-queued:
  --tool <tool>    agent for the new workspace: claude, codex, opencode, or pi.
                   Omitted, inherits this workspace's tool, then the project
                   default, then claude. Must be logged in on the host (see
                   `yaac-mama models`) or the new agent can't authenticate.
  --model <model>  model id the agent launches with — any id the tool accepts:
                   a model id/alias for claude/codex (e.g. opus), provider/model
                   for opencode and pi (e.g. anthropic/claude-opus-4-8).
  --permission-mode <mode>
                   how much the new agent may do before it asks: bypass, auto,
                   accept-edits, manual, then plan or read-only (codex's
                   strictest), most permissive first.
                   Omitted, it inherits this workspace's own. It can never be
                   more permissive than this workspace's: asking for more is an
                   error. Not every tool has every mode (pi has only bypass).
  --ui-mode <mode> how the agent is driven: tui (its terminal UI, the default)
                   or acp (a chat pane in the yaac webapp).
  --branch <name>  reference branch on origin for the new workspace. Omitted,
                   the project's default branch.
  --group <name>   file the new workspace in this group, creating it if needed.
  --title <title>  the sidebar title; omitted, it is titled from its prompt.

queue also takes, and requires:
  --parent-workspace <id>
                   what the queued workspace waits on: a workspace in this
                   project ("$YAAC_WORKSPACE_ID" for this one), or a queued
                   workspace's id (to chain after it). Options it omits
                   default to that parent's settings; the permission mode is
                   still never more permissive than this workspace's own.

edit-queued changes the queued workspace <queued> names: each option given
replaces its setting (--parent-workspace re-parents it), and a prompt given
replaces its prompt. A queued workspace more permissive than this one is
refused until the edit names a permission mode at or below this workspace's,
or a new --tool (whose permission mode is then resolved at or below it).

queue saves a workspace to start when its parent is STOPPED — by
`yaac-mama stop` or by the user. A parent that crashes or exits does not
start it; it waits for the user. It forks from the latest origin tip of the
parent's reference branch.

create prints the new workspace's id and queue the queued workspace's id;
a create provisions in the background (watch it in the yaac webapp).
Everything else prints a short report.

fetch copies another workspace's branches and HEAD, running or stopped, into
this checkout as refs/yaac/peers/<id>/<branch> and refs/yaac/peers/<id>/HEAD,
where <id> is its first 8 characters (e.g. `git log yaac/peers/1a2b3c4d/HEAD`).
Only committed work travels. Fetching again replaces those refs.

history reads another workspace's agent conversations, running or stopped.
With no conversation it lists them (CONVERSATION is the id the other forms
take, or a unique prefix of it). Naming one prints its JSONL transcripts to
stdout, the main one first and then its subagents'. -o <dir> saves every
file of that conversation, or of all of them, as <dir>/<conversation>/...
(a file over 256 MB is skipped, and named on stderr),
including what the transcripts point at (claude's saved tool results) and,
for a chat-pane (acp) conversation, yaac's own record as acpd.jsonl.

opencode keeps its history in one SQLite database per workspace. Each of its
conversations is handed out as a copy of that database (opencode.db), which
this script turns into the same JSONL shape with python3: one line per
message, the conversation first and then the sessions its subagents ran,
under subagents/ with -o.

stop ends a workspace's running container/tmux server and keeps its checkout,
title, group and conversation, so the user can restart it. Stopping YOURSELF
tears down what this command's own reply travels over, so the confirmation
may never print — the workspace ending is the confirmation. Do everything that
must outlive the workspace (commit, push, report) before you run it.
EOF
}

# JSON-encode one string as a quoted scalar. Byte-oriented and locale-proof:
# the shell hands awk raw bytes, and only the seven characters JSON requires
# are rewritten, so any UTF-8 in a prompt or group name passes through whole.
json_string() {
  awk 'BEGIN{
    s = ARGV[1]
    gsub(/\\/, "\\\\", s)
    gsub(/"/, "\\\"", s)
    gsub(/\n/, "\\n", s)
    gsub(/\r/, "\\r", s)
    gsub(/\t/, "\\t", s)
    printf "%s", "\"" s "\""
  }' "$1"
}

# Unwrap {"output":"…"} into $text and undo the escaping above, so it is
# what the server rendered.
unwrap_output() {
  text=$(printf '%s' "$1" \
    | sed -n 's/^{"output":"\(.*\)"}$/\1/p' \
    | sed 's/\\n/\
/g; s/\\t/	/g; s/\\r//g; s/\\"/"/g; s/\\\\/\\/g')
}

# Pull the message out of {"error":"…"}, for a refusal the server described.
error_text() {
  printf '%s' "$1" | sed -n 's/.*"error":"\(.*\)"}$/\1/p' | sed 's/\\"/"/g; s/\\\\/\\/g'
}

# One command's JSON envelope. $1 command, $2 body, then alternating arg
# name/value pairs (a pair with an empty value is omitted, so an unset option
# is absent rather than blank).
envelope() {
  cmd=$1; body=$2; shift 2
  args=""
  sep=""
  while [ $# -gt 1 ]; do
    if [ -n "$2" ]; then
      args="$args$sep$(json_string "$1"):$(json_string "$2")"
      sep=","
    fi
    shift 2
  done
  printf '%s' "{\"command\":$(json_string "$cmd"),\"args\":{$args},\"body\":$(json_string "$body")}"
}

# Run one command whose answer is text, into $text. Arguments as envelope.
ask() {
  resp=$(envelope "$@" | curl -sS --max-time 300 \
    -H 'Content-Type: application/json' \
    -H "Authorization: Bearer ${YAAC_MAMA_TOKEN:-}" \
    --data-binary @- -w '\n%{http_code}' \
    "$URL/api/workspace/mama") || {
    echo "yaac-mama: cannot reach the yaac server at $URL" >&2
    exit 1
  }

  code=$(printf '%s\n' "$resp" | tail -n 1)
  payload=$(printf '%s\n' "$resp" | sed '$d')
  if [ "$code" != "200" ]; then
    msg=$(error_text "$payload")
    echo "yaac-mama: ${msg:-${payload:-request failed}} (HTTP $code)" >&2
    exit 1
  fi
  unwrap_output "$payload"
}

# Run one command whose answer is text, and print it. Command substitution
# ate any trailing newlines, so exactly one goes back on — a caller doing
# `id=$(yaac-mama create …)` gets a clean value, and a caller reading a table
# gets it terminated.
run() {
  ask "$@"
  printf '%s\n' "$text"
  exit 0
}

# Run one command whose answer is a file, into $tmp/body, with the id of the
# workspace it is about in $id. Arguments as envelope. A partial download
# fails (curl exits non-zero), so $tmp/body is only ever whole.
download() {
  if [ -z "${tmp:-}" ]; then
    tmp=$(mktemp -d) || exit 1
    trap 'rm -rf "$tmp"' EXIT
  fi
  code=$(envelope "$@" | curl -sS --max-time 3600 \
      -H 'Content-Type: application/json' \
      -H "Authorization: Bearer ${YAAC_MAMA_TOKEN:-}" \
      --data-binary @- -D "$tmp/headers" -o "$tmp/body" -w '%{http_code}' \
      "$URL/api/workspace/mama") || {
    echo "yaac-mama: cannot reach the yaac server at $URL, or the download broke off" >&2
    exit 1
  }
  if [ "$code" != "200" ]; then
    payload=$(cat "$tmp/body" 2>/dev/null)
    msg=$(error_text "$payload")
    echo "yaac-mama: ${msg:-${payload:-request failed}} (HTTP $code)" >&2
    exit 1
  fi
  id=$(tr 'A-Z' 'a-z' < "$tmp/headers" | sed -n 's/^x-yaac-workspace-id: *\([0-9a-f-]*\).*/\1/p' | tail -n 1)
}

# Turn opencode database $1 into JSONL for session $2 and every session under
# it (its subagents'): to stdout, or with $3 into $3/<session>.jsonl and
# $3/subagents/<session>.jsonl, printing each path. One line per message, in
# order. Read immutable, so nothing is written beside the copy. Another
# workspace wrote the database, so session ids become file names only when
# they look like opencode's own.
opencode_jsonl() {
  command -v python3 >/dev/null 2>&1 || {
    echo "yaac-mama: python3 is needed to read opencode's database ($1)" >&2
    return 1
  }
  python3 - "$@" <<'PY'
import json, os, pathlib, re, sqlite3, sys
db, root = sys.argv[1], sys.argv[2]
out = sys.argv[3] if len(sys.argv) > 3 else None
conn = sqlite3.connect(pathlib.Path(db).absolute().as_uri() + "?immutable=1", uri=True)
sessions, seen = [root], {root}
for sid in sessions:
    for (child,) in conn.execute("select id from session_v2 where parent_id = ? order by time_created", (sid,)):
        if child not in seen and re.fullmatch(r"ses_[A-Za-z0-9]+", child):
            seen.add(child)
            sessions.append(child)
for sid in sessions:
    if out is None:
        f = sys.stdout
    else:
        path = os.path.join(out, f"{sid}.jsonl" if sid == root else os.path.join("subagents", f"{sid}.jsonl"))
        os.makedirs(os.path.dirname(path), exist_ok=True)
        f = open(path, "w")
    rows = conn.execute(
        "select type, seq, time_created, data from session_message where session_id = ? order by seq", (sid,))
    for (kind, seq, created, data) in rows:
        try:
            data = json.loads(data)
        except ValueError:
            pass
        f.write(json.dumps({"session": sid, "type": kind, "seq": seq, "time": created, "data": data}) + "\n")
    if out is not None:
        f.close()
        print(path)
PY
}

# Fetch another workspace's branches. The answer is a git bundle. The
# receiving git checks every object (transfer.fsckObjects), since another
# workspace wrote them.
fetch_workspace() {
  workdir=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo 'yaac-mama: run fetch from inside your checkout' >&2
    exit 2
  }
  download fetch '' workspace "$1"
  short=$(printf '%.8s' "$id")
  [ -n "$short" ] || { echo 'yaac-mama: the server named no workspace' >&2; exit 1; }
  git -C "$workdir" -c transfer.fsckObjects=true fetch --quiet --prune --no-tags "$tmp/body" \
    "+refs/heads/*:refs/yaac/peers/$short/*" "+HEAD:refs/yaac/peers/$short/HEAD" || exit 1
  git -C "$workdir" for-each-ref --format='%(refname:lstrip=1)' "refs/yaac/peers/$short/"
  exit 0
}

[ $# -gt 0 ] || { usage >&2; exit 2; }

case "$1" in
  -h|--help) usage; exit 0 ;;

  list) run list '' ;;

  models) run models '' ;;

  fetch)
    shift
    if [ $# -ne 1 ] || [ -z "$1" ]; then
      echo 'usage: yaac-mama fetch <workspace>' >&2
      exit 2
    fi
    fetch_workspace "$1"
    ;;

  history)
    shift
    workspace=""; conversation=""; out=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -o|--out)
          [ $# -ge 2 ] && [ -n "$2" ] || { echo "yaac-mama: $1 needs a directory" >&2; exit 2; }
          out=$2; shift 2 ;;
        *)
          if [ -z "$workspace" ]; then workspace=$1
          elif [ -z "$conversation" ]; then conversation=$1
          else extra=1
          fi
          shift ;;
      esac
    done
    if [ -z "$workspace" ] || [ -n "${extra:-}" ]; then
      echo 'usage: yaac-mama history <workspace> [<conversation>] [-o <dir>]' >&2
      exit 2
    fi
    if [ -n "$out" ]; then
      # A file per request, not one archive: GNU tar cannot unpack under
      # gVisor, which lacks the openat2 call it extracts with.
      # Every opencode conversation of a workspace hands out the same
      # database, so it is downloaded once.
      ask history '' workspace "$workspace" conversation "$conversation" files 1
      database=""
      while IFS= read -r name; do
        case "$name" in
          '') continue ;;
          '# '*) echo "yaac-mama: ${name#\# }" >&2; continue ;;
        esac
        conv=${name%%/*}
        mkdir -p "$(dirname "$out/$name")" || exit 1
        if [ "${name#*/}" = opencode.db ] && [ -n "$database" ]; then
          cp "$database" "$out/$name" || exit 1
        else
          download history '' workspace "$workspace" conversation "$conv" file "${name#*/}"
          mv "$tmp/body" "$out/$name" || exit 1
        fi
        printf '%s\n' "$out/$name"
        if [ "${name#*/}" = opencode.db ]; then
          database=$out/$name
          opencode_jsonl "$out/$name" "$conv" "$out/$conv" || echo "yaac-mama: kept $out/$name as it is" >&2
        fi
      done <<EOF
$text
EOF
      exit 0
    fi
    [ -n "$conversation" ] || run history '' workspace "$workspace"
    download history '' workspace "$workspace" conversation "$conversation"
    if grep -qi '^content-type: *application/vnd.sqlite3' "$tmp/headers"; then
      conv=$(tr -d '\r' < "$tmp/headers" | sed -n 's/^[Xx]-[Yy]aac-[Cc]onversation-[Ii]d: *//p' | tail -n 1)
      opencode_jsonl "$tmp/body" "$conv" || exit 1
    else
      cat "$tmp/body"
    fi
    exit 0
    ;;

  create|queue|edit-queued)
    cmd=$1; shift
    tool=""; model=""; perm=""; ui_mode=""; branch=""; group=""; title=""; parent=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --tool|--model|--permission-mode|--ui-mode|--branch|--group|--title|--parent-workspace)
          [ $# -ge 2 ] && [ -n "$2" ] || { echo "yaac-mama: $1 needs a value" >&2; exit 2; } ;;
        *) break ;;
      esac
      case "$1" in
        --tool) tool=$2 ;;
        --model) model=$2 ;;
        --permission-mode) perm=$2 ;;
        --ui-mode) ui_mode=$2 ;;
        --branch) branch=$2 ;;
        --group) group=$2 ;;
        --title) title=$2 ;;
        --parent-workspace) parent=$2 ;;
      esac
      shift 2
    done
    opts='[--tool T] [--model M] [--permission-mode P] [--ui-mode U] [--branch B] [--group G] [--title T]'
    queued=""; prompt=""
    case "$cmd" in
      create)
        if [ $# -ne 1 ] || [ -z "$1" ]; then
          echo "usage: yaac-mama create $opts \"<prompt>\"" >&2
          exit 2
        fi
        prompt=$1
        ;;
      queue)
        if [ -z "$parent" ] || [ $# -ne 1 ] || [ -z "$1" ]; then
          echo "usage: yaac-mama queue --parent-workspace W $opts \"<prompt>\"" >&2
          exit 2
        fi
        prompt=$1
        ;;
      edit-queued)
        # The prompt is optional (omitted keeps the stored one), but one that
        # is present and empty is refused: `edit-queued "$id" "$p"` with $p
        # unset meant to change the prompt, not to leave it.
        if [ $# -lt 1 ] || [ $# -gt 2 ] || [ -z "$1" ] || { [ $# -eq 2 ] && [ -z "$2" ]; }; then
          echo "usage: yaac-mama edit-queued [--parent-workspace W] $opts <queued> [\"<prompt>\"]" >&2
          exit 2
        fi
        queued=$1; prompt=${2:-}
        ;;
    esac
    run "$cmd" "$prompt" queued "$queued" parent-workspace "$parent" tool "$tool" model "$model" \
      permission-mode "$perm" ui-mode "$ui_mode" branch "$branch" group "$group" title "$title"
    ;;

  rename)
    shift
    # One argument retitles the caller, two retitle the workspace named first.
    if [ $# -lt 1 ] || [ $# -gt 2 ] || [ -z "$1" ]; then
      echo 'usage: yaac-mama rename [<workspace>] "<title>"' >&2
      exit 2
    fi
    if [ $# -eq 1 ]; then
      run rename "$1"
    else
      run rename "$2" workspace "$1"
    fi
    ;;

  stop)
    shift
    # No argument stops the caller — the same "omitted means me" idiom rename
    # uses, and the common case here. `run` drops an empty-valued pair, so
    # that sends no `workspace` at all, which is what the server reads as "me".
    #
    # An argument that is present but EMPTY is refused rather than treated as
    # absent, which is the one place those two must not mean the same thing:
    # `yaac-mama stop "$id"` with $id unset is a caller that plainly meant to
    # name a sibling, and letting it fall through to the default would stop
    # the caller instead — silently, and unstoppably by then.
    if [ $# -gt 1 ] || { [ $# -eq 1 ] && [ -z "$1" ]; }; then
      echo 'usage: yaac-mama stop [<workspace>]   (omit the workspace to stop yourself)' >&2
      exit 2
    fi
    run stop '' workspace "${1:-}"
    ;;

  group)
    shift
    [ $# -gt 0 ] || { echo 'usage: yaac-mama group create|move …' >&2; exit 2; }
    sub=$1; shift
    case "$sub" in
      create)
        if [ $# -ne 1 ] || [ -z "$1" ]; then
          echo 'usage: yaac-mama group create "<name>"' >&2
          exit 2
        fi
        run group-create "$1"
        ;;
      move)
        # The group is optional, and omitting it is how a caller says "no
        # group" — the same idiom `yaac group move` uses, where a bare `--`
        # could never work (its parser eats it as end-of-options).
        if [ $# -lt 1 ] || [ $# -gt 2 ] || [ -z "$1" ]; then
          echo 'usage: yaac-mama group move <workspace> ["<group>"]   (omit the group to ungroup)' >&2
          exit 2
        fi
        run group-move "${2:-}" workspace "$1"
        ;;
      *)
        echo "yaac-mama: unknown group subcommand '$sub' (expected: create, move)" >&2
        exit 2
        ;;
    esac
    ;;

  *)
    echo "yaac-mama: unknown command '$1' (expected: list, create, queue, edit-queued, rename, stop, group, models, fetch, history)" >&2
    echo 'run "yaac-mama --help" for usage' >&2
    exit 2
    ;;
esac
