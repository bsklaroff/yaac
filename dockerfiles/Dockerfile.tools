ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Neovim — split out of Dockerfile.default so it can be rebuilt independently
# (via `yaac project rebuild`) to pick up new upstream releases without
# re-running the slow apt/Node base build. Needs root to write under
# /usr/local; the base image ends as USER yaac, so switch back afterward.
USER root
RUN ARCH="$(dpkg --print-architecture)" && if [ "$ARCH" = "amd64" ]; then ARCH=x86_64; fi && \
    curl -fsSL "https://github.com/neovim/neovim/releases/download/v0.12.4/nvim-linux-${ARCH}.tar.gz" | \
    tar -xz -C /usr/local --strip-components=1 && \
    ln -sf /usr/local/bin/nvim /usr/local/bin/vi && \
    ln -sf /usr/local/bin/nvim /usr/local/bin/vim
# fd (sharkdp/fd) for pi's file-search tool. pi otherwise auto-downloads the
# latest sharkdp/fd release into ~/.pi/agent/bin the first time the tool runs
# when no `fd`/`fdfind` is on PATH; pre-staging the same release binary on PATH
# lets pi find it and skips that runtime fetch (which would hit GitHub through
# the egress proxy). pi's other tool binary, ripgrep (`rg`), ships in the base
# image. Keep in step with sharkdp/fd's latest release.
RUN ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in amd64) ARCH=x86_64 ;; arm64) ARCH=aarch64 ;; esac && \
    FD_VERSION=10.4.2 && \
    curl -fsSL "https://github.com/sharkdp/fd/releases/download/v${FD_VERSION}/fd-v${FD_VERSION}-${ARCH}-unknown-linux-gnu.tar.gz" | \
    tar -xz -C /usr/local/bin --strip-components=1 --wildcards '*/fd' && \
    chmod +x /usr/local/bin/fd
USER yaac
ENV EDITOR=nvim

# Agent CLIs and MCP servers. Split out of Dockerfile.default so they can be
# rebuilt with `--no-cache` (via `yaac project rebuild`) to pick up new
# upstream versions (e.g. when Claude Code ships a new release) without
# re-running the slow apt/Node base build.
RUN npm install -g chrome-devtools-mcp@0.24.0
RUN npm install -g @openai/codex
# opencode-ai pinned to 1.0.142: it is the last release whose TUI renders under
# gVisor. Starting at 1.0.143 opencode's native @opentui/core renderer blocks on
# a terminal-capability handshake (pixel-resolution query) that our headless
# session tmux never answers, so the agent pane stays blank (upstream
# anomalyco/opencode#29802). The session env sets OPENCODE_DISABLE_AUTOUPDATE=1
# (see packages/server/src/features/sessions/create.ts) so a launched pod can't
# npm-upgrade itself back off this pin. Revisit when the upstream renderer is
# fixed under gVisor.
RUN npm install -g opencode-ai@1.0.142
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent
RUN curl -fsSL https://claude.ai/install.sh | bash

# Codex transcript-discovery hook, installed as a Codex *managed hook* in the
# trusted /etc/codex layer. Codex gates hooks declared in the user-writable
# ~/.codex/hooks.json behind a per-change `/hooks` trust approval; managed
# hooks under /etc/codex are trusted by policy and bypass that gate, so this
# runs in every session with no manual approval prompt. The SessionStart hook
# reads Codex's hook-input JSON on stdin, extracts transcript_path, and
# symlinks it into ~/.codex/.yaac-transcripts/<YAAC_SESSION_ID>.jsonl
# (YAAC_SESSION_ID is injected into the pod env by session-create) so yaac can
# find each session's rollout JSONL. In requirements.toml: `managed_dir` scopes
# where managed-hook commands may live, `[features] hooks` pins the (default-on)
# hook engine, and `apps = false` disables the codex_apps MCP server whose
# handshake fails and warns on startup (openai/codex#16550). The system
# config.toml layer sets check_for_update_on_startup = false so a fresh pod
# skips codex's startup update probe (against api.github.com) and drops
# straight to the agent input instead of stalling on a version check — which
# matters for yaac-spawn's unattended sessions. The script text is exercised by
# packages/server/test/codex-hook-script.test.ts. Verified against codex-cli
# 0.144.5.
USER root
RUN mkdir -p /etc/codex/hooks && cat <<'HOOK' > /etc/codex/hooks/yaac-session-start.sh
#!/bin/sh
INPUT=$(cat)
TRANSCRIPT=$(echo "$INPUT" | sed -n 's/.*"transcript_path"\s*:\s*"\([^"]*\)".*/\1/p')
if [ -n "$TRANSCRIPT" ] && [ -n "$YAAC_SESSION_ID" ]; then
  LINK_DIR=/home/yaac/.codex/.yaac-transcripts
  mkdir -p "$LINK_DIR"
  REL=$(python3 -c "import os.path; print(os.path.relpath('$TRANSCRIPT', '$LINK_DIR'))")
  ln -sf "$REL" "$LINK_DIR/$YAAC_SESSION_ID.jsonl"
fi
HOOK
RUN printf 'check_for_update_on_startup = false\n' > /etc/codex/config.toml
RUN chmod 755 /etc/codex/hooks/yaac-session-start.sh && cat <<'REQ' > /etc/codex/requirements.toml
[features]
hooks = true
apps = false

[hooks]
managed_dir = "/etc/codex/hooks"

[[hooks.SessionStart]]
matcher = "*"
[[hooks.SessionStart.hooks]]
type = "command"
command = "/etc/codex/hooks/yaac-session-start.sh"
timeout = 10
REQ
USER yaac
