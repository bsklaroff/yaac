FROM docker.io/ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates catatonit curl file fonts-liberation git \
    jq less libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 \
    libcairo2 libcups2t64 libdbus-1-3 libgbm1 libnspr4 libnss3 libpango-1.0-0 \
    libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
    libxkbcommon0 libxrandr2 locales ncat netcat-openbsd openssh-client \
    pipx podman python3 python3-pip python3-venv ripgrep socat sudo tmux \
    wget xz-utils zsh && \
    sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen && update-locale LANG=en_US.UTF-8 && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
      https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*
RUN ARCH="$(dpkg --print-architecture)" && if [ "$ARCH" = "amd64" ]; then ARCH=x64; fi && \
    curl -fsSL "https://nodejs.org/dist/v22.22.2/node-v22.22.2-linux-${ARCH}.tar.xz" | \
    tar -xJ -C /usr/local --strip-components=1
RUN ARCH="$(dpkg --print-architecture)" && if [ "$ARCH" = "amd64" ]; then ARCH=x86_64; fi && \
    curl -fsSL "https://github.com/neovim/neovim/releases/download/v0.10.4/nvim-linux-${ARCH}.tar.gz" | \
    tar -xz -C /usr/local --strip-components=1 && \
    ln -sf /usr/local/bin/nvim /usr/local/bin/vi && \
    ln -sf /usr/local/bin/nvim /usr/local/bin/vim
RUN corepack enable
RUN PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers \
      npx -y playwright-core@1.50.1 install chromium --no-shell && \
    rm -rf /opt/playwright-browsers/ffmpeg-* /opt/playwright-browsers/.links && \
    mkdir -p /opt/google && \
    ln -sfn /opt/playwright-browsers/chromium-*/chrome-linux /opt/google/chrome

# Session pods run in user namespaces (hostUsers: false) with identity-
# idmapped hostPath mounts, so yaac's uid must equal the uid the node sees
# on daemon-created host files (the daemon's uid). The daemon injects it at
# build time; the uid is part of the image's content-hash tag.
ARG YAAC_UID=1000
RUN userdel -r ubuntu 2>/dev/null; useradd -m -u ${YAAC_UID} -s /bin/zsh yaac && \
    echo 'yaac ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers
USER yaac

RUN npm config set prefix /home/yaac/.local
RUN corepack install -g pnpm@11.1.2 && \
    pnpm config set store-dir /home/yaac/.cached-packages/pnpm-store

ENV LANG=en_US.UTF-8
ENV TERM=xterm-256color
ENV HOME=/home/yaac
ENV PATH="/home/yaac/.local/bin:${PATH}"
ENV EDITOR=nvim
ENV SHELL=/bin/zsh
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN cat <<'EOF' > ~/.zshrc
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
PS1="%n@${YAAC_SESSION_ID:0:8} %~ $ "
alias ls='ls --color=auto'
alias grep='grep --color=auto'
EOF

WORKDIR /workspace
# catatonit acts as PID 1, reaping zombies (orphaned conmon etc.) and
# forwarding signals.  Without a real init, rootless podman leaks zombie
# conmon processes under PID 1 and eventually hits RLIMIT_NPROC.
ENTRYPOINT ["catatonit", "--", "sleep", "infinity"]
