FROM docker.io/ubuntu:26.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates catatonit curl file fonts-liberation git \
    jq less libarchive-tools libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 \
    libatspi2.0-0t64 libcairo2 libcups2t64 libdbus-1-3 libgbm1 libnspr4 libnss3 \
    libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 \
    libxfixes3 libxkbcommon0 libxrandr2 locales ncat netcat-openbsd openssh-client \
    pipx python3 python3-pip python3-venv ripgrep socat sudo tmux \
    wget xz-utils zsh && \
    sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen && update-locale LANG=en_US.UTF-8 && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
      https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*
# Ubuntu's GNU tar extracts nested paths through openat2, which gVisor does
# not implement, and it does not fall back, so in a pod it fails with
# "Function not implemented". This `tar`, first on PATH, hands an extraction
# using only options bsdtar shares to bsdtar, which uses plain openat. Any
# other call goes to GNU tar unchanged, including dpkg's, whose GNU-only
# options bsdtar rejects.
RUN cat <<'EOF' > /usr/local/bin/tar && chmod 755 /usr/local/bin/tar
#!/bin/sh
extract=
case $1 in -*|*[!xzJjvfpOC]*) ;; *x*) extract=1 ;; esac
for a; do
  case $a in
    -|--|--strip-components|--strip-components=*|--no-same-owner|--file|\
    --file=*|--directory|--directory=*|--gzip|--xz|--bzip2|--verbose) ;;
    --extract) extract=1 ;;
    --*|-*[!xzJjvfpOC]*) exec /usr/bin/tar "$@" ;;
    -*x*) extract=1 ;;
  esac
done
[ -n "$extract" ] && exec /usr/bin/bsdtar "$@"
exec /usr/bin/tar "$@"
EOF
# Dockerfile.server and the proxy/netd images use the same Node version.
ARG NODE_VERSION=24.21.0
RUN ARCH="$(dpkg --print-architecture)" && if [ "$ARCH" = "amd64" ]; then ARCH=x64; fi && \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.xz" | \
    tar -xJ -C /usr/local --strip-components=1
RUN corepack enable
# streamd: the in-pod stream daemon (PTY/ctrl/exec/tcp streams) the server
# dials through the proxy relay. Started by the pod's setup, not the
# entrypoint. Its source is part of this image's content hash (see
# baseImageHash); dockerfiles/.containerignore excludes its dev-only files.
COPY streamd/ /opt/yaac/streamd/
RUN cd /opt/yaac/streamd && npm install --omit=dev --no-audit --no-fund
# acpd: the in-pod supervisor for an ACP agent (see acpd/acpd.js). It has no
# dependencies, so needs no install step. Also part of baseImageHash.
COPY acpd/ /opt/yaac/acpd/
# Install full Chromium (symlinked to /opt/google/chrome for tools that
# auto-detect it, e.g. chrome-devtools-mcp) and Playwright's headless shell.
# The tree is made group-0 writable so a project pinning another Playwright
# can add browser revisions. That runs in this same layer because a separate
# `chgrp -R` layer would copy the whole ~1GB tree. The Chromium directory is
# chrome-linux64 on x64 and chrome-linux on arm64.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
ARG PLAYWRIGHT_VERSION=1.63.0
RUN npx -y playwright-core@${PLAYWRIGHT_VERSION} install chromium && \
    rm -rf /opt/playwright-browsers/ffmpeg-* /opt/playwright-browsers/.links && \
    mkdir -p /opt/google && \
    ln -sfn /opt/playwright-browsers/chromium-*/chrome-linux* /opt/google/chrome && \
    chgrp -R 0 /opt/playwright-browsers && chmod -R g=u /opt/playwright-browsers

# The image works under any uid (docs/arbitrary-uid-images.md). `yaac` is uid
# 1000 with primary group 0, and everything it owns is group-writable, so a
# pod running as any uid with supplementary group 0 (installSecurityContext)
# can use it. So `RUN` steps as yaac, here and in derived layers, need
# `umask 002`. /etc/passwd is group-writable so yaac-workspace-init can point
# the `yaac` entry at the pod's real uid (getpwuid and sudo need it).
RUN userdel -r ubuntu 2>/dev/null; useradd -m -u 1000 -g 0 -s /bin/zsh yaac && \
    echo 'yaac ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers && \
    chmod -R g=u /home/yaac && \
    chgrp 0 /etc/passwd && chmod g=u /etc/passwd
# Replace the distro's compinit, which rescans every completion function
# through the gVisor gofer (10-30s) when the $fpath file count differs from
# build time, as it does in a pod. `compinit -C` trusts the baked dump, and
# the first interactive shell of a pod starts one detached full refresh so
# completions installed later still show up.
RUN echo 'skip_global_compinit=1' >> /etc/zsh/zshenv && cat <<'EOF' >> /etc/zsh/zshrc

# yaac: fast completion init (the distro block above is skipped via
# skip_global_compinit in /etc/zsh/zshenv). -C sources the image-baked
# ~/.zcompdump without the audit or staleness scan; the once-per-pod
# marker gates a detached full refresh so later shells see completions
# added after the image was built.
autoload -Uz compinit
compinit -C
if [[ ! -e $HOME/.zcompdump.refreshed ]]; then
  : >| $HOME/.zcompdump.refreshed
  (nice -n 19 zsh -fc 'autoload -Uz compinit && compinit && rm -f ~/.zcompdump.zwc && zcompile ~/.zcompdump' >/dev/null 2>&1 &)
fi
EOF
USER yaac

# Every directory the pod mounts something inside. A missing parent would be
# created by the container runtime as root:root 0755, unwritable by yaac.
# ~/.yaac matters most: it holds the opencode checkpoint mount and is a nested
# yaac server's data dir.
RUN umask 002 && mkdir -p /home/yaac/.yaac /home/yaac/.config /home/yaac/.local/share

# Set as ENV rather than in ~/.npmrc: npm chmods that file when it rewrites
# it, which needs ownership, so a pod running as another uid could not.
ENV NPM_CONFIG_PREFIX=/home/yaac/.local
# No pnpm store-dir here: a workspace's store is per pod and differs by
# layout, so the workspace env names it (docs/workspace-storage.md). Not
# pnpm 12, which copies rather than hardlinks when node_modules is its own
# mount, as a workspace's module dirs are.
RUN umask 002 && corepack install -g pnpm@11.28.2
# Same version as the playwright-core that installed Chromium above, so
# `chromium.launch()` finds the prebuilt browser.
RUN umask 002 && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g playwright@${PLAYWRIGHT_VERSION}

ENV LANG=en_US.UTF-8
ENV TERM=xterm-256color
ENV HOME=/home/yaac
ENV USER=yaac
ENV PATH="/home/yaac/.local/bin:${PATH}"
ENV SHELL=/bin/zsh
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# lstat on the gVisor /workspace mount is slow (~0.6ms cold), so a cold
# `git status` crosses git's 2s progress threshold and prints a "Refresh
# index" bar. Raise the threshold; ENV covers tooling as well as shells.
ENV GIT_PROGRESS_DELAY=10

RUN umask 002 && cat <<'EOF' > ~/.zshrc
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
PS1="%n@${YAAC_WORKSPACE_ID:0:8} %~ $ "
alias ls='ls --color=auto'
alias grep='grep --color=auto'
EOF

# Bake the zsh completion dump so the first shell in a pod skips a 17-30s
# scan under gVisor (see the /etc/zsh/zshrc block above).
RUN umask 002 && zsh -c 'autoload -Uz compinit && compinit && zcompile ~/.zcompdump'

WORKDIR /workspace
# catatonit is PID 1: it reaps zombies and forwards signals. Without it, a
# nested workspace's engine (Dockerfile.nestable) leaks zombie conmon
# processes until it hits RLIMIT_NPROC.
ENTRYPOINT ["catatonit", "--", "sleep", "infinity"]
