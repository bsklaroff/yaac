FROM docker.io/ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates catatonit curl file fonts-liberation git \
    jq less libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 \
    libcairo2 libcups2t64 libdbus-1-3 libgbm1 libnspr4 libnss3 libpango-1.0-0 \
    libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
    libxkbcommon0 libxrandr2 locales ncat netcat-openbsd openssh-client \
    pipx python3 python3-pip python3-venv ripgrep socat sudo tmux \
    wget xz-utils zsh && \
    sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen && update-locale LANG=en_US.UTF-8 && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
      https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*
RUN ARCH="$(dpkg --print-architecture)" && if [ "$ARCH" = "amd64" ]; then ARCH=x64; fi && \
    curl -fsSL "https://nodejs.org/dist/v22.22.2/node-v22.22.2-linux-${ARCH}.tar.xz" | \
    tar -xJ -C /usr/local --strip-components=1
RUN corepack enable
# streamd: the in-pod stream daemon the server dials through the proxy
# relay (PTY/ctrl/exec/tcp streams — the kubectl-exec replacement).
# Installed under /opt with its prebuilt node-pty dependency; started by
# session-create's setup exec, never by the image entrypoint. Its source
# is folded into this layer's content hash (see baseImageHash), and
# dockerfiles/.containerignore keeps its dev-only files out of the context.
COPY streamd/ /opt/yaac/streamd/
RUN cd /opt/yaac/streamd && npm install --omit=dev --no-audit --no-fund
# acpd: the in-pod supervisor for an ACP agent process. Runs in a tmux window
# and exposes the agent's stdio on a UNIX socket the server attaches to, so a
# dropped connection never kills a turn. Dependency-free (plain node), so
# unlike streamd it needs no install step. Its source is folded into this
# layer's content hash (see baseImageHash) alongside streamd's.
COPY acpd/ /opt/yaac/acpd/
# Install both the full Chromium (symlinked to /opt/google/chrome for tools
# that auto-detect it, e.g. chrome-devtools-mcp) and the headless shell that
# Playwright's default `chromium.launch()` looks for. PLAYWRIGHT_BROWSERS_PATH
# is exported so Playwright finds these prebuilt browsers at runtime instead
# of re-downloading into ~/.cache/ms-playwright.
# The tree is left group-0 writable so a project pinning a different Playwright
# can install new browser revisions into it. That grant happens HERE rather
# than in a later step because a `chgrp -R` in its own layer copies the whole
# ~1GB tree up into that layer.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
RUN npx -y playwright-core@1.50.1 install chromium && \
    rm -rf /opt/playwright-browsers/ffmpeg-* /opt/playwright-browsers/.links && \
    mkdir -p /opt/google && \
    ln -sfn /opt/playwright-browsers/chromium-*/chrome-linux /opt/google/chrome && \
    chgrp -R 0 /opt/playwright-browsers && chmod -R g=u /opt/playwright-browsers

# The image is UID-AGNOSTIC (docs/arbitrary-uid-images.md). `yaac` is a fixed
# uid 1000 whose PRIMARY GROUP IS 0, and every path it owns is group-writable
# (`g=u`), so a pod running as ANY uid works as long as it carries a
# supplementary group 0 — which every yaac pod does (hostUidSecurityContext).
# The uid a pod runs as is still the install host's, because the data dir is a
# hostPath and virtiofs makes that uid a ceiling; it is simply no longer baked
# in, so one image serves every host.
#
# Two consequences for anything added below or in a derived layer: `RUN` steps
# that run as yaac need `umask 002` so what they create stays group-writable,
# and /etc/passwd is group-writable because yaac-worktree-init re-points the
# `yaac` entry at the uid the pod actually runs as (getpwuid has no answer for
# an arbitrary uid otherwise, and passwordless sudo matches on the NAME).
RUN userdel -r ubuntu 2>/dev/null; useradd -m -u 1000 -g 0 -s /bin/zsh yaac && \
    echo 'yaac ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers && \
    chmod -R g=u /home/yaac && \
    chgrp 0 /etc/passwd && chmod g=u /etc/passwd
# Replace the distro zshrc's compinit with a fast-path + background-refresh
# variant. The distro's plain `compinit` re-validates the dump by counting
# $fpath files, and inside a session pod that count comes out one off from
# build time — so it re-scanned every completion function through the gVisor
# gofer (10-30s) on the session's first shell, discarding the baked dump.
# Ours: `compinit -C` trusts the dump unconditionally (instant, every
# shell), then the FIRST interactive shell of a pod kicks off one detached
# full compinit that rebuilds the dump against the live $fpath — so
# completion files installed after the image build (or the runtime count
# quirk) are folded in for every later shell, without any shell waiting.
RUN echo 'skip_global_compinit=1' >> /etc/zsh/zshenv && cat <<'EOF' >> /etc/zsh/zshrc

# yaac: fast completion init (the distro block above is skipped via
# skip_global_compinit in /etc/zsh/zshenv). -C sources the image-baked
# ~/.zcompdump without the audit or staleness scan; the once-per-pod
# marker gates a detached full refresh so later shells see completions
# added after the image was built.
autoload -Uz compinit
compinit -C
if [[ ! -e $HOME/.zcompdump.refreshed ]]; then
  : >| $HOME/.zcompdump.refreshed
  (nice -n 19 zsh -fc 'autoload -Uz compinit && compinit && rm -f ~/.zcompdump.zwc && zcompile ~/.zcompdump' >/dev/null 2>&1 &)
fi
EOF
USER yaac

# Every directory the pod mounts something *inside*. A mount whose parent is
# missing gets that parent created by the container runtime, as root:root
# 0755, and then nothing running as yaac can write the directory at all —
# which is why they are made here, owned by yaac, rather than left to appear
# on their own. ~/.yaac is the case that bites: it takes the session-starts
# log mount and it is also a nested yaac server's data dir, so a root-created
# one fails that server's first write. The other two exist today only because
# pnpm and claude's installer happen to write under them; naming them makes
# the invariant the image's rather than those tools'.
RUN umask 002 && mkdir -p /home/yaac/.yaac /home/yaac/.config /home/yaac/.local/share

# The global npm prefix, as ENV rather than a baked ~/.npmrc. npm chmods that
# file every time it rewrites it (`npm config set`, `npm login`), and chmod
# needs OWNERSHIP of the file — which no group grant can supply, so a pod
# running as another uid could never run either command. As env there is no
# file to fight over until the pod writes its own.
ENV NPM_CONFIG_PREFIX=/home/yaac/.local
RUN umask 002 && corepack install -g pnpm@11.1.2 && \
    pnpm config set store-dir /home/yaac/.cached-packages/pnpm-store
# Playwright pinned to the same version as the chromium installed above
# (playwright-core@1.50.1 → chromium build 1155), so `chromium.launch()`
# resolves the prebuilt browser at PLAYWRIGHT_BROWSERS_PATH. Skip the bundled
# browser download — the binaries already live there. Installs the `playwright`
# CLI on PATH; scripts that import the module use its absolute path or `npx`.
RUN umask 002 && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g playwright@1.50.1

ENV LANG=en_US.UTF-8
ENV TERM=xterm-256color
ENV HOME=/home/yaac
ENV USER=yaac
ENV PATH="/home/yaac/.local/bin:${PATH}"
ENV SHELL=/bin/zsh
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# /workspace is a gVisor gofer mount (lisafs+directfs), so every lstat is
# sentry-mediated (~0.6ms cold, vs ~µs on a native bind mount). `git status`
# refreshes the index by lstat-ing all tracked files, and on a session's cold
# first shell that step crosses git's default 2s delayed-progress threshold,
# painting a "Refresh index: N/N" bar that never appeared pre-gVisor. Push the
# threshold out so the cosmetic bar stays hidden; a genuinely long op (>10s)
# still surfaces one. Set via ENV (not zshrc) to cover every shell and any
# git invoked by tooling, not just interactive zsh.
ENV GIT_PROGRESS_DELAY=10

RUN umask 002 && cat <<'EOF' > ~/.zshrc
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
PS1="%n@${YAAC_WORKTREE_ID:0:8} %~ $ "
alias ls='ls --color=auto'
alias grep='grep --color=auto'
EOF

# Pre-generate (and zcompile) the zsh completion dump. Debian's global
# /etc/zsh/zshrc runs compinit, whose FIRST run scans every completion
# function under $fpath — thousands of cold gofer reads inside the gVisor
# sentry, measured at 17–30s for a session's first interactive shell
# (each pod's home overlay starts fresh, so every session paid it). With
# the dump baked into the image and the global compinit patched to -C
# (see the /etc/zsh/zshrc sed above), every shell — including the first —
# just sources the dump.
RUN umask 002 && zsh -c 'autoload -Uz compinit && compinit && zcompile ~/.zcompdump'

WORKDIR /workspace
# catatonit acts as PID 1, reaping zombies (orphaned conmon etc.) and
# forwarding signals.  Without a real init, the in-pod engine a nested
# worktree runs (Dockerfile.nestable) leaks zombie conmon processes under
# PID 1 and eventually hits RLIMIT_NPROC.  It stays in THIS image because
# PID 1 is the entrypoint's to choose, and every worktree wants its
# zombies reaped whether or not it has an engine.
ENTRYPOINT ["catatonit", "--", "sleep", "infinity"]
