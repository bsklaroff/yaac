FROM docker.io/ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates catatonit curl file fonts-liberation git \
    jq less libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 \
    libcairo2 libcups2t64 libdbus-1-3 libgbm1 libnspr4 libnss3 libpango-1.0-0 \
    libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
    libxkbcommon0 libxrandr2 locales ncat netcat-openbsd openssh-client \
    pipx podman python3 python3-pip python3-venv ripgrep socat sudo tmux \
    wget xz-utils zsh && \
    sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen && update-locale LANG=en_US.UTF-8 && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
      https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*
RUN ARCH="$(dpkg --print-architecture)" && if [ "$ARCH" = "amd64" ]; then ARCH=x64; fi && \
    curl -fsSL "https://nodejs.org/dist/v22.22.2/node-v22.22.2-linux-${ARCH}.tar.xz" | \
    tar -xJ -C /usr/local --strip-components=1
RUN corepack enable
# Install both the full Chromium (symlinked to /opt/google/chrome for tools
# that auto-detect it, e.g. chrome-devtools-mcp) and the headless shell that
# Playwright's default `chromium.launch()` looks for. PLAYWRIGHT_BROWSERS_PATH
# is exported so Playwright finds these prebuilt browsers at runtime instead
# of re-downloading into ~/.cache/ms-playwright.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
RUN npx -y playwright-core@1.50.1 install chromium && \
    rm -rf /opt/playwright-browsers/ffmpeg-* /opt/playwright-browsers/.links && \
    mkdir -p /opt/google && \
    ln -sfn /opt/playwright-browsers/chromium-*/chrome-linux /opt/google/chrome

# Session pods run in user namespaces (hostUsers: false) with identity-
# idmapped hostPath mounts, so yaac's uid must equal the uid the node sees
# on server-created host files (the server's uid). The server injects it at
# build time; the uid is part of the image's content-hash tag.
ARG YAAC_UID=1000
RUN userdel -r ubuntu 2>/dev/null; useradd -m -u ${YAAC_UID} -s /bin/zsh yaac && \
    echo 'yaac ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers && \
    chown -R yaac:yaac /opt/playwright-browsers
# Replace the distro zshrc's compinit with a fast-path + background-refresh
# variant. The distro's plain `compinit` re-validates the dump by counting
# $fpath files, and inside a session pod that count comes out one off from
# build time — so it re-scanned every completion function through the gVisor
# gofer (10-30s) on the session's first shell, discarding the baked dump.
# Ours: `compinit -C` trusts the dump unconditionally (instant, every
# shell), then the FIRST interactive shell of a pod kicks off one detached
# full compinit that rebuilds the dump against the live $fpath — so
# completion files installed after the image build (or the runtime count
# quirk) are folded in for every later shell, without any shell waiting.
RUN echo 'skip_global_compinit=1' >> /etc/zsh/zshenv && cat <<'EOF' >> /etc/zsh/zshrc

# yaac: fast completion init (the distro block above is skipped via
# skip_global_compinit in /etc/zsh/zshenv). -C sources the image-baked
# ~/.zcompdump without the audit or staleness scan; the once-per-pod
# marker gates a detached full refresh so later shells see completions
# added after the image was built.
autoload -Uz compinit
compinit -C
if [[ ! -e $HOME/.zcompdump.refreshed ]]; then
  : >| $HOME/.zcompdump.refreshed
  (nice -n 19 zsh -fc 'autoload -Uz compinit && compinit && rm -f ~/.zcompdump.zwc && zcompile ~/.zcompdump' >/dev/null 2>&1 &)
fi
EOF
USER yaac

RUN npm config set prefix /home/yaac/.local
RUN corepack install -g pnpm@11.1.2 && \
    pnpm config set store-dir /home/yaac/.cached-packages/pnpm-store
# Playwright pinned to the same version as the chromium installed above
# (playwright-core@1.50.1 → chromium build 1155), so `chromium.launch()`
# resolves the prebuilt browser at PLAYWRIGHT_BROWSERS_PATH. Skip the bundled
# browser download — the binaries already live there. Installs the `playwright`
# CLI on PATH; scripts that import the module use its absolute path or `npx`.
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g playwright@1.50.1

ENV LANG=en_US.UTF-8
ENV TERM=xterm-256color
ENV HOME=/home/yaac
ENV USER=yaac
ENV PATH="/home/yaac/.local/bin:${PATH}"
ENV SHELL=/bin/zsh
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# /workspace is a gVisor gofer mount (lisafs+directfs), so every lstat is
# sentry-mediated (~0.6ms cold, vs ~µs on a native bind mount). `git status`
# refreshes the index by lstat-ing all tracked files, and on a session's cold
# first shell that step crosses git's default 2s delayed-progress threshold,
# painting a "Refresh index: N/N" bar that never appeared pre-gVisor. Push the
# threshold out so the cosmetic bar stays hidden; a genuinely long op (>10s)
# still surfaces one. Set via ENV (not zshrc) to cover every shell and any
# git invoked by tooling, not just interactive zsh.
ENV GIT_PROGRESS_DELAY=10

RUN cat <<'EOF' > ~/.zshrc
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
PS1="%n@${YAAC_SESSION_ID:0:8} %~ $ "
alias ls='ls --color=auto'
alias grep='grep --color=auto'
EOF

# Pre-generate (and zcompile) the zsh completion dump. Debian's global
# /etc/zsh/zshrc runs compinit, whose FIRST run scans every completion
# function under $fpath — thousands of cold gofer reads inside the gVisor
# sentry, measured at 17–30s for a session's first interactive shell
# (each pod's home overlay starts fresh, so every session paid it). With
# the dump baked into the image and the global compinit patched to -C
# (see the /etc/zsh/zshrc sed above), every shell — including the first —
# just sources the dump.
RUN zsh -c 'autoload -Uz compinit && compinit && zcompile ~/.zcompdump'

WORKDIR /workspace
# catatonit acts as PID 1, reaping zombies (orphaned conmon etc.) and
# forwarding signals.  Without a real init, rootless podman leaks zombie
# conmon processes under PID 1 and eventually hits RLIMIT_NPROC.
ENTRYPOINT ["catatonit", "--", "sleep", "infinity"]
