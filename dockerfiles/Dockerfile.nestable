ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends podman skopeo && \
    rm -rf /var/lib/apt/lists/*

# crun from upstream, which containers.conf below selects over the archive's
# (a podman dependency). Under gVisor, crun 1.21 fails every container start
# ("cannot resolve `null` under rootfs") and 1.29+ fails to mount tmpfs on
# sys/firmware; 1.22-1.28 work. Check nested `docker run` before bumping.
RUN curl -fsSL -o /usr/local/bin/crun \
      "https://github.com/containers/crun/releases/download/1.28/crun-1.28-linux-$(dpkg --print-architecture)" && \
    chmod 755 /usr/local/bin/crun

# Docker CLI + compose plugin, pointed (DOCKER_HOST below) at the rootful
# podman socket, which serves the Docker Engine API. No buildx: its default
# driver pulls moby/buildkit, which the egress proxy blocks; compose falls
# back to the classic build endpoint podman implements.
RUN ARCH="$(uname -m)" && \
    curl -fsSL "https://download.docker.com/linux/static/stable/${ARCH}/docker-29.8.2.tgz" | \
      tar -xz -C /usr/local/bin --strip-components=1 docker/docker && \
    mkdir -p /usr/local/lib/docker/cli-plugins && \
    curl -fsSL "https://github.com/docker/compose/releases/download/v5.5.1/docker-compose-linux-${ARCH}" \
      -o /usr/local/lib/docker/cli-plugins/docker-compose && \
    chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Rootful podman inside the gVisor sandbox, as in gVisor's docker-in-gvisor
# tutorial. Root in the sandbox has no host authority, so none of the
# rootless setup (id maps, userns, /proc binds) is needed. The yaac user
# drives the engine over a socket served by a root `podman system service`
# started at workspace setup. See docs/nested-containers.md.
#
# Nested containers share the pod's namespaces. With netns=host a listener
# binds in the pod netns (`docker run -p` is a no-op) and egress goes through
# the pod's transparent redirect (docs/workspace-egress.md). base_hosts_file
# carries the pod's hostAliases into nested containers. Private container
# networks (compose's default bridge, `--network`) do not work under gVisor,
# so use `network_mode: host`.
#
# CA trust for nested containers. Volumes reach both `podman run` and
# `docker build` RUN steps; env reaches only `podman run` (buildah ignores
# containers.conf env for builds). Tools with their own bundle (curl,
# requests, cargo, git) replace their whole trust set with one file, so they
# get ca-bundle.pem (public roots + proxy CA, written by the proxy).
#   - The proxy CA is mounted into /usr/local/share/ca-certificates/, so
#     `update-ca-certificates` (run by installing ca-certificates) adds it to
#     the image's system bundle during builds. Mounting over
#     /etc/ssl/certs/ca-certificates.crt directly would break that command:
#     it renames onto the file, which fails EBUSY on a bind mount.
#   - At run time, SSL_CERT_FILE/NODE_EXTRA_CA_CERTS point at the proxy CA
#     and the per-tool vars at the combined bundle.
RUN cat <<'EOF' > /etc/containers/containers.conf
[containers]
netns="host"
ipcns="host"
utsns="host"
cgroupns="host"
cgroups="disabled"
log_driver="k8s-file"
base_hosts_file="/etc/hosts"
volumes = [
  "/etc/yaac/certs/proxy-ca.pem:/etc/yaac/certs/proxy-ca.pem:ro",
  "/etc/yaac/certs/ca-bundle.pem:/etc/yaac/certs/ca-bundle.pem:ro",
  "/etc/yaac/certs/proxy-ca.pem:/usr/local/share/ca-certificates/yaac-proxy-ca.crt:ro",
]
env = [
  "SSL_CERT_FILE=/etc/yaac/certs/proxy-ca.pem",
  "NODE_EXTRA_CA_CERTS=/etc/yaac/certs/proxy-ca.pem",
  "CURL_CA_BUNDLE=/etc/yaac/certs/ca-bundle.pem",
  "REQUESTS_CA_BUNDLE=/etc/yaac/certs/ca-bundle.pem",
  "CARGO_HTTP_CAINFO=/etc/yaac/certs/ca-bundle.pem",
  "GIT_SSL_CAINFO=/etc/yaac/certs/ca-bundle.pem",
]
default_sysctls = []
[engine]
cgroup_manager="cgroupfs"
events_logger="file"
runtime="crun"
[engine.runtimes]
crun = ["/usr/local/bin/crun"]
EOF

# Unqualified image names resolve to docker.io, as with the docker CLI.
# Nested pulls go through the egress proxy to allowlisted registries.
RUN cat <<'EOF' > /etc/containers/registries.conf
unqualified-search-registries = ["docker.io"]
EOF

# The graphroot sits on a gVisor-internal tmpfs the pod mounts at
# /var/lib/containers. gVisor's gofer filesystem rejects security.* xattr
# writes, so `setcap` in a build step (e.g. apt postinsts) would fail there.
# The tmpfs is disk-backed, so layer data is reclaimable page cache. podman
# requires graphroot/runroot once a [storage] section exists.
#
# additionalimagestores adds the node-local image store, a read-only cache of
# the project registry that the server writes and hostPath-mounts here
# (drivers/k8s/images/store-writer.ts), so a new workspace sees warm layers
# without pulling. The directory is baked empty so a workspace starts when
# there is nothing to mount.
RUN mkdir -p /var/lib/containers /var/lib/shared-images
RUN cat <<'EOF' > /etc/containers/storage.conf
[storage]
driver = "overlay"
runroot = "/run/containers/storage"
graphroot = "/var/lib/containers/storage"
[storage.options]
additionalimagestores = ["/var/lib/shared-images"]
EOF

USER yaac
# Point docker and podman (remote mode via CONTAINER_HOST) at the rootful
# engine's socket, so the yaac user needs no sudo. `sudo` drops both vars, so
# root commands like `podman system service` still use the local engine.
ENV DOCKER_HOST=unix:///run/podman/podman.sock
ENV CONTAINER_HOST=unix:///run/podman/podman.sock
