ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root

RUN ARCH="$(dpkg --print-architecture)" && \
    if [ "$ARCH" = "arm64" ]; then \
      MIRROR="http://ports.ubuntu.com/ubuntu-ports"; \
    else \
      MIRROR="http://archive.ubuntu.com/ubuntu"; \
    fi && \
    printf 'Types: deb\nURIs: %s\nSuites: plucky plucky-updates\nComponents: main universe\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' "$MIRROR" \
      > /etc/apt/sources.list.d/ubuntu-plucky.sources
RUN cat <<'EOF' > /etc/apt/preferences.d/ubuntu-plucky
Package: *
Pin: release n=plucky
Pin-Priority: 100
EOF
RUN apt-get update && \
    apt-get install -y --no-install-recommends -t plucky podman crun skopeo && \
    rm -rf /var/lib/apt/lists/*

# Docker CLI + compose plugin — both routed at DOCKER_HOST below to the
# ROOTFUL podman socket, which serves the Docker Engine API. Running a real
# dockerd here would need a second nested engine under podman; the podman
# socket avoids that. Buildx is omitted on purpose — its default
# docker-container driver wants to pull moby/buildkit, which our egress
# proxy forbids; compose falls back to the classic build endpoint that
# podman implements.
RUN ARCH="$(dpkg --print-architecture)" && \
    if [ "$ARCH" = "amd64" ]; then DOCKER_ARCH=x86_64; COMPOSE_ARCH=x86_64; \
    else DOCKER_ARCH=aarch64; COMPOSE_ARCH=aarch64; fi && \
    curl -fsSL "https://download.docker.com/linux/static/stable/${DOCKER_ARCH}/docker-29.5.3.tgz" | \
      tar -xz -C /usr/local/bin --strip-components=1 docker/docker && \
    mkdir -p /usr/local/lib/docker/cli-plugins && \
    curl -fsSL "https://github.com/docker/compose/releases/download/v5.1.4/docker-compose-linux-${COMPOSE_ARCH}" \
      -o /usr/local/lib/docker/cli-plugins/docker-compose && \
    chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# kubectl — for virtualCluster sessions (KUBECONFIG points at the
# session's vcluster) and yaac-in-yaac. Pinned; lives in this layer
# rather than tools so non-nested sessions stay untouched.
RUN ARCH="$(dpkg --print-architecture)" && \
    curl -fsSL "https://dl.k8s.io/release/v1.34.1/bin/linux/${ARCH}/kubectl" \
      -o /usr/local/bin/kubectl && \
    chmod +x /usr/local/bin/kubectl

# Rootful-in-sandbox podman: the engine runs as REAL root inside the gVisor
# sentry — the upstream-tested docker-in-gvisor shape
# (https://gvisor.dev/docs/tutorials/docker-in-gvisor/). In-sandbox root is a
# sentry fiction with no host authority, so no rootless apparatus is needed:
# no id-map ranges, no id-map helper caps, no host userns, no keyring/
# pivot_root workarounds, no /proc bind — pivot_root, fresh /proc, and kernel
# keyrings all work under the sentry.
# The agent runs as the yaac user and drives the engine over the socket
# (DOCKER_HOST); the socket is served by a root `podman system service` that
# session-create starts (via sudo) and opens to the yaac user.
#
# Every nested container shares the pod's namespaces: netns=host means a
# container's listener binds directly in the pod netns (curl localhost just
# works; `docker run -p` is a no-op) and its egress stays on the session's
# transparent redirect — netd's DNAT rule matches the pod's host-side veth,
# which every frame from a nested container leaves by (k8s/netd/rules.ts,
# docs/session-egress.md). base_hosts_file extends the
# pod's hostAliases (e.g. the per-project registry name) into nested
# containers. Container-private networks (the default `docker compose`
# bridge, `docker run --network ...`) are still NOT supported in-pod — the
# userspace network helpers (pasta/slirp4netns/netavark) don't run under the
# sentry netstack — so use `network_mode: host`.
#
# CA trust rides here (rootful engine reads /etc/containers/containers.conf,
# not the per-user file). Two delivery mechanisms, because env and volumes
# reach different places:
#   VOLUMES reach BOTH `podman run` and `docker build` RUN steps; ENV
#   reaches `podman run` but NOT `docker build` RUN (buildah does not apply
#   containers.conf [containers] env to build steps — verified by
#   test/e2e-cli/nested-containers.test.ts). So build-time trust must ride a
#   volume, not an env var.
# The trust set must be the union {public roots} ∪ {proxy CA} for the
# own-bundle tools (curl, requests, cargo, git-libcurl) that ignore
# SSL_CERT_FILE and REPLACE their whole trust set with a single file —
# pointed at the lone proxy CA they reject the REAL certs of every tunnelled
# host (most allowlisted registries/mirrors). The combined bundle (public
# roots + proxy CA) is served by the proxy's /ca-bundle.pem and mounted here.
# See docs/nested-containers.md.
#   CA-CERTIFICATES DROP-IN — the bare proxy CA is bind-mounted as a source
#     cert in /usr/local/share/ca-certificates/. `update-ca-certificates`
#     (run by `apt-get install ca-certificates`, the usual way a build gains
#     HTTPS, and by many packages' triggers) folds it into the image's real
#     roots, producing the correct union in the image's own
#     /etc/ssl/certs/ca-certificates.crt — which curl reads by default with
#     no env. This is the build-time path. We must NOT bind-mount over
#     /etc/ssl/certs/ca-certificates.crt directly: that file is what
#     update-ca-certificates rewrites (temp file + rename), and rename() onto
#     a bind-mountpoint fails EBUSY, so the ca-certificates postinst — and
#     the whole build — fails. The drop-in composes with
#     update-ca-certificates instead of fighting it. (A build that runs curl
#     against a MITM host WITHOUT ever installing/refreshing ca-certificates
#     won't pick this up; that path is covered at run-time by the env vars
#     below, or by running update-ca-certificates.)
#   ENV (run-time) — SSL_CERT_FILE/NODE_EXTRA_CA_CERTS additively on the bare
#     proxy CA; CURL_CA_BUNDLE/REQUESTS_CA_BUNDLE/CARGO_HTTP_CAINFO/
#     GIT_SSL_CAINFO on the combined bundle, for the own-bundle tools
#     (notably requests/cargo) that read neither the OS store nor
#     SSL_CERT_FILE.
RUN cat <<'EOF' > /etc/containers/containers.conf
[containers]
netns="host"
ipcns="host"
utsns="host"
cgroupns="host"
cgroups="disabled"
log_driver="k8s-file"
base_hosts_file="/etc/hosts"
volumes = [
  "/etc/yaac/certs/proxy-ca.pem:/etc/yaac/certs/proxy-ca.pem:ro",
  "/etc/yaac/certs/ca-bundle.pem:/etc/yaac/certs/ca-bundle.pem:ro",
  "/etc/yaac/certs/proxy-ca.pem:/usr/local/share/ca-certificates/yaac-proxy-ca.crt:ro",
]
env = [
  "SSL_CERT_FILE=/etc/yaac/certs/proxy-ca.pem",
  "NODE_EXTRA_CA_CERTS=/etc/yaac/certs/proxy-ca.pem",
  "CURL_CA_BUNDLE=/etc/yaac/certs/ca-bundle.pem",
  "REQUESTS_CA_BUNDLE=/etc/yaac/certs/ca-bundle.pem",
  "CARGO_HTTP_CAINFO=/etc/yaac/certs/ca-bundle.pem",
  "GIT_SSL_CAINFO=/etc/yaac/certs/ca-bundle.pem",
]
default_sysctls = []
[engine]
cgroup_manager="cgroupfs"
events_logger="file"
runtime="crun"
EOF

# docker-CLI parity for unqualified image names: `docker pull nginx` means
# docker.io. Static and baked — nested pulls go straight through the MITM
# proxy (allowlisted upstream registries), so there is no per-project
# registry remap here.
RUN cat <<'EOF' > /etc/containers/registries.conf
unqualified-search-registries = ["docker.io"]
EOF

# Rootful graphroot. It lives at podman's rootful default
# (/var/lib/containers/storage), backed by a sentry-internal tmpfs the pod
# spec mounts at /var/lib/containers: gVisor's gofer filesystem refuses
# WRITES to the security.* xattr namespace (goferfs checkXattrPermissions
# → EOPNOTSUPP), so a `docker build` RUN step doing `setcap` (apt/apk
# postinsts for ping, nginx, …) fails on a gofer-backed graphroot — only
# a sentry tmpfs upper holds file caps (verified on the dev cluster; the
# docker-in-gvisor tutorial's shape). The tmpfs is disk-backed (runsc
# filestore in the emptyDir), so layer data is reclaimable node page cache,
# not pod-pinned memory.
# graphroot/runroot are set EXPLICITLY because once a [storage] section
# exists podman refuses to default them ("runroot must be set").
#
# additionalimagestores adds ONE read-only lower: the node-local image
# store, a per-(node, project) containers/storage the server materializes
# from the project registry and hostPath-mounts here (store-builder.ts).
# It is a CACHE of the registry, which stays the distribution mechanism and
# the thing that survives a node dying — this only makes the project's warm
# layers visible to a fresh session's engine with no pull and no graphroot
# spend, shared by every session on the node. The directory is baked in
# EMPTY so a session with no generation to mount (a cold node, an inner
# yaac whose vcluster denies the hostPath) still starts: containers/storage
# treats an empty additional store as no images.
RUN mkdir -p /var/lib/containers /var/lib/shared-images
RUN cat <<'EOF' > /etc/containers/storage.conf
[storage]
driver = "overlay"
runroot = "/run/containers/storage"
graphroot = "/var/lib/containers/storage"
[storage.options]
additionalimagestores = ["/var/lib/shared-images"]
EOF

USER yaac
# Both CLIs target the ROOTFUL engine over its socket: docker is always a
# client (DOCKER_HOST), and podman auto-enters remote mode when CONTAINER_HOST
# is set — so the yaac user drives the root daemon without sudo, and a bare
# `podman pull/build/push` (the agent's, and an inner yaac server's image
# machinery) reaches the same engine. `sudo` strips both via env_reset, so the
# root `podman system service` and the promoter still run as a local engine.
ENV DOCKER_HOST=unix:///run/podman/podman.sock
ENV CONTAINER_HOST=unix:///run/podman/podman.sock
