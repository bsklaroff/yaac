# The yaac server itself, as a container image.
#
# Under the k8s driver the server runs as an in-cluster Deployment
# (docs/server-in-cluster.md). The build context is `dist/`, the npm bundle:
# cli.js, the SPA, drizzle migrations, the other images' build contexts, and a
# `package.json` naming cli.js's externals with catalog pins resolved
# (scripts/write-dist-manifest.ts), since the build host may lack pnpm.
#
# Built by `yaac cluster install` on the CLI's machine, never in-cluster
# (docs/trust-split-builds.md), and tagged by the context's content hash.
FROM docker.io/ubuntu:26.04

# Keep in step with Dockerfile.default's Node version.
ARG NODE_VERSION=24.21.0
# The server uses kubectl for cluster writes and execs. Keep it within one minor
# version of the kind node's Kubernetes.
ARG KUBECTL_VERSION=v1.37.1
# Baked so auto-titles need no download, since a pod's $HOME does not
# survive a roll. The builder passes LLAMA_CPP_TAG from
# domain/titles/llama-cpp.ts.
ARG LLAMA_CPP_TAG=b11313

# catatonit: node is PID 1 here and would never reap the orphans of the
# processes the server spawns (kubectl, git). libgomp1: the llama.cpp
# release links it and does not ship it. netcat-openbsd: under YAAC_USE_TOR
# the server's own ssh (host-key fetch, git over ssh) dials through
# `ProxyCommand=nc -X 5 -x …` (torSshOpts).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates catatonit curl git libgomp1 netcat-openbsd openssh-client tar xz-utils && \
    rm -rf /var/lib/apt/lists/*

RUN ARCH="$(dpkg --print-architecture)" && if [ "$ARCH" = "amd64" ]; then ARCH=x64; fi && \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.xz" | \
    tar -xJ -C /usr/local --strip-components=1

RUN ARCH="$(dpkg --print-architecture)" && \
    curl -fsSL -o /usr/local/bin/kubectl \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" && \
    chmod 0755 /usr/local/bin/kubectl && \
    kubectl version --client

# Replace ubuntu's uid-1000 user with `yaac`. The image works under any uid
# (docs/arbitrary-uid-images.md): `yaac` has primary group 0 and its files are
# group-writable, so the pod's uid (with supplementary group 0) can write
# them. /etc/passwd is group-writable so the entrypoint can fix the entry.
RUN userdel -r ubuntu 2>/dev/null; useradd -m -u 1000 -g 0 -s /bin/bash yaac && \
    chmod -R g=u /home/yaac && \
    chgrp 0 /etc/passwd && chmod g=u /etc/passwd

RUN mkdir -p /home/yaac/.cache/yaac/llama-cpp && \
    ARCH="$(dpkg --print-architecture)" && if [ "$ARCH" = "amd64" ]; then ARCH=x64; fi && \
    curl -fsSL "https://github.com/ggml-org/llama.cpp/releases/download/${LLAMA_CPP_TAG}/llama-${LLAMA_CPP_TAG}-bin-ubuntu-${ARCH}.tar.gz" \
      | tar -xz -C /home/yaac/.cache/yaac/llama-cpp && \
    chown -R yaac:0 /home/yaac && chmod -R g=u /home/yaac

COPY . /opt/yaac/
# Install cli.js's unbundled externals from the manifest shipped beside it
# (checked at build time by scripts/check-cli-externals.ts).
RUN cd /opt/yaac && npm install --omit=dev --no-audit --no-fund --no-package-lock && \
    npm cache clean --force && \
    chown -R yaac:0 /opt/yaac && chmod -R g=u /opt/yaac && \
    chmod 0755 /opt/yaac/dockerfiles/server-entrypoint.sh

USER yaac
ENV HOME=/home/yaac
WORKDIR /home/yaac
# See server-entrypoint.sh.
ENTRYPOINT ["/opt/yaac/dockerfiles/server-entrypoint.sh"]
CMD ["server", "run"]
