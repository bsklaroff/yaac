{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@proxy/*": ["./k8s/proxy/*"],
      "@relay/*": ["./k8s/relay/*"]
    }
  },
  "include": ["src", "test", "scripts", "*.config.ts", "k8s/proxy/proxy.ts", "k8s/proxy/ca-bundle.ts", "k8s/proxy/transparent.ts", "k8s/proxy/pp2.ts", "k8s/proxy/pod-watch.ts", "k8s/proxy/dns-stub.ts", "k8s/relay/relay.ts", "k8s/relay/pp2-frame.ts", "k8s/relay/dns-stub.ts"],
  "exclude": ["node_modules", "dist", "src/frontend", "vite.config.ts"]
}
