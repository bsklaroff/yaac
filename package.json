{
  "name": "@bsklaroff/yaac",
  "version": "0.1.5",
  "description": "Yet Another Agent Container",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsklaroff/yaac.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "bin": {
    "yaac": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:acpd && pnpm build:cli && pnpm build:frontend && pnpm build:assets && pnpm build:id",
    "build:watch": "pnpm build:acpd && pnpm build:cli && tsx scripts/build-frontend-if-changed.ts && pnpm build:assets && pnpm build:id",
    "build:acpd": "sh scripts/build-acpd.sh",
    "build:cli": "tsup && tsup --config tsup.helpers.config.ts && tsx scripts/check-cli-externals.ts",
    "build:frontend": "pnpm --filter @yaac/frontend build",
    "build:assets": "rm -rf dist/frontend && cp -r packages/frontend/dist dist/frontend && rm -f dist/frontend/.input-hash && cp -r dockerfiles k8s builtin-skills workspace-bin host-shell dist/ && rm -rf dist/drizzle && cp -r packages/server/drizzle dist/drizzle && rm -rf dist/k8s/proxy/node_modules dist/k8s/proxy/test dist/k8s/netd/node_modules dist/k8s/netd/test dist/k8s/tailgate/node_modules dist/k8s/tailgate/test dist/dockerfiles/streamd/test dist/dockerfiles/streamd/node_modules dist/dockerfiles/acpd/acpd_test.go dist/dockerfiles/acpd/bin/.input-hash dist/dockerfiles/agent-patches/test && find dist/k8s/mountd -name '*_test.go' -delete && tsx scripts/write-dist-manifest.ts",
    "build:id": "tsx scripts/write-build-id.ts",
    "dev": "tsx packages/cli/src/cli.ts",
    "gc:test-images": "tsx scripts/gc-test-images.ts",
    "gen:providers": "tsx scripts/gen-tool-providers.ts",
    "watch": "tsx watch --clear-screen=false --include 'packages/**/src/**' --include 'packages/server/drizzle/**' --include 'dockerfiles/**' --include 'k8s/**' --include 'builtin-skills/**' --include 'workspace-bin/**' --include package.json --include 'packages/*/package.json' --include pnpm-lock.yaml --include tsup.config.ts --include 'packages/frontend/vite.config.ts' --exclude '**/node_modules/**' --exclude 'k8s/proxy/test/**' --exclude 'dockerfiles/acpd/bin/**' --exclude 'packages/desktop/**' scripts/dev-watch.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p packages/frontend/tsconfig.json && eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project 'unit:*'",
    "test:e2e": "vitest run --project e2e",
    "test:e2e-cli": "vitest run test/e2e-cli",
    "test:api": "vitest run --project 'api-*'",
    "test:api-k8s": "vitest run --project api-k8s",
    "test:api-containerless": "vitest run --project api-containerless",
    "test:apiserver": "vitest run --project apiserver",
    "test:mountd": "sh scripts/test-mountd.sh",
    "test:acpd": "sh scripts/test-acpd.sh",
    "test:failures": "tsx scripts/test-failures.ts",
    "test:slowest": "tsx scripts/test-slowest.ts",
    "test:watch": "vitest",
    "frontend:dev": "pnpm --filter @yaac/frontend dev",
    "frontend:build": "pnpm --filter @yaac/frontend build",
    "desktop:dev": "pnpm --filter @yaac/desktop dev",
    "desktop:hot": "pnpm --filter @yaac/desktop dev:hot",
    "desktop:build": "pnpm --filter @yaac/desktop build",
    "desktop:package": "pnpm --filter @yaac/desktop app:build",
    "desktop:install": "pnpm --filter @yaac/desktop app:install",
    "desktop:release": "pnpm --filter @yaac/desktop app:release",
    "desktop:release-mac": "pnpm --filter @yaac/desktop app:release-mac",
    "desktop:release-linux": "pnpm --filter @yaac/desktop app:release-linux",
    "desktop:release-win": "pnpm --filter @yaac/desktop app:release-win",
    "prepublishOnly": "pnpm build",
    "modularity": "tsx scripts/modularity.ts",
    "depcruise": "depcruise"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@kubernetes/client-node": "catalog:",
    "@lydell/node-pty": "catalog:",
    "asn1js": "catalog:",
    "better-auth": "catalog:",
    "commander": "catalog:",
    "croner": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "pkijs": "catalog:",
    "smol-toml": "catalog:",
    "ws": "catalog:",
    "yaml": "catalog:",
    "yazl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@vitest/coverage-v8": "5.0.2",
    "@yaac/auth-daemon": "workspace:*",
    "@yaac/cli": "workspace:*",
    "@yaac/desktop": "workspace:*",
    "@yaac/frontend": "workspace:*",
    "@yaac/server": "workspace:*",
    "@yaac/shared": "workspace:*",
    "@yaac/test-utils": "workspace:*",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "pi-acp": "0.0.34",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  },
  "imports": {
    "#support/*": "./test/support/*.js"
  }
}
