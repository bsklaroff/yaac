{
  "name": "@bsklaroff/yaac",
  "version": "0.0.3",
  "description": "Agent sandbox manager",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsklaroff/yaac.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "bin": {
    "yaac": "dist/cli.js"
  },
  "main": "dist-electron/main.mjs",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && vite build && cp -r dockerfiles k8s dist/ && rm -rf dist/k8s/proxy/node_modules dist/k8s/relay/node_modules && tsx scripts/write-build-id.ts",
    "dev": "tsx src/cli.ts",
    "watch": "tsx watch --clear-screen=false --include 'src/**' --include 'dockerfiles/**' --include 'k8s/**' --include package.json --include pnpm-lock.yaml --include tsup.config.ts --include vite.config.ts --exclude '**/node_modules/**' scripts/dev-watch.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.frontend.json && eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "test:e2e-cli": "vitest run test/e2e-cli",
    "test:api": "vitest run test/api",
    "test:watch": "vitest",
    "frontend:dev": "vite",
    "frontend:build": "vite build",
    "electron:build": "tsup --config tsup.electron.config.ts",
    "electron:dev": "bash scripts/dev-app.sh",
    "app:stage": "tsx scripts/stage-app.ts",
    "app:build": "pnpm build && pnpm electron:build && pnpm app:stage && electron-builder --config electron-builder.yml",
    "app:install": "pnpm app:build && tsx scripts/install-app.ts",
    "prepare": "./setup-git.sh",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.111",
    "@base-ui/react": "1.5.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@fontsource-variable/inter": "5.2.8",
    "@hono/node-server": "1.19.14",
    "@hono/node-ws": "1.3.1",
    "@hono/zod-validator": "0.7.6",
    "@lydell/node-pty": "1.1.0",
    "@openai/codex": "0.121.0",
    "@tanstack/react-query": "5.100.14",
    "@uiw/react-codemirror": "4.25.10",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "2.1.1",
    "commander": "14.0.3",
    "hono": "4.12.14",
    "lucide-react": "1.17.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "simple-git": "3.35.2",
    "smol-toml": "1.6.1",
    "yaml": "2.9.0",
    "zod": "4.3.6",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.5.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.6.0",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "eslint": "10.2.0",
    "globals": "17.4.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.1",
    "vite": "7.0.4",
    "vitest": "4.1.3",
    "ws": "8.21.0"
  }
}
