{
  "name": "@bsklaroff/yaac",
  "version": "0.0.6",
  "description": "Agent sandbox manager",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsklaroff/yaac.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "bin": {
    "yaac": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:cli && pnpm build:frontend && pnpm build:assets && pnpm build:id",
    "build:watch": "pnpm build:cli && tsx scripts/build-frontend-if-changed.ts && pnpm build:assets && pnpm build:id",
    "build:cli": "tsup && tsx scripts/check-cli-externals.ts",
    "build:frontend": "pnpm --filter @yaac/frontend build",
    "build:assets": "rm -rf dist/frontend && cp -r packages/frontend/dist dist/frontend && rm -f dist/frontend/.input-hash && cp -r dockerfiles k8s builtin-skills worktree-bin dist/ && rm -rf dist/drizzle && cp -r packages/server/drizzle dist/drizzle && rm -rf dist/k8s/proxy/node_modules dist/k8s/proxy/test dist/k8s/netd/node_modules dist/k8s/netd/test dist/dockerfiles/streamd/test dist/dockerfiles/streamd/node_modules dist/dockerfiles/acpd/test dist/dockerfiles/acpd/node_modules && tsx scripts/write-dist-manifest.ts",
    "build:id": "tsx scripts/write-build-id.ts",
    "dev": "tsx packages/cli/src/cli.ts",
    "gen:providers": "tsx scripts/gen-tool-providers.ts",
    "watch": "tsx watch --clear-screen=false --include 'packages/**/src/**' --include 'packages/server/drizzle/**' --include 'dockerfiles/**' --include 'k8s/**' --include 'builtin-skills/**' --include 'worktree-bin/**' --include package.json --include 'packages/*/package.json' --include pnpm-lock.yaml --include tsup.config.ts --include 'packages/frontend/vite.config.ts' --exclude '**/node_modules/**' --exclude 'k8s/proxy/test/**' --exclude 'packages/desktop/**' scripts/dev-watch.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p packages/frontend/tsconfig.json && eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project 'unit:*'",
    "test:e2e": "vitest run --project e2e",
    "test:e2e-cli": "vitest run test/e2e-cli",
    "test:api": "vitest run --project 'api-*'",
    "test:api-k8s": "vitest run --project api-k8s",
    "test:api-containerless": "vitest run --project api-containerless",
    "test:failures": "tsx scripts/test-failures.ts",
    "test:watch": "vitest",
    "frontend:dev": "pnpm --filter @yaac/frontend dev",
    "frontend:build": "pnpm --filter @yaac/frontend build",
    "desktop:dev": "pnpm --filter @yaac/desktop dev",
    "desktop:hot": "pnpm --filter @yaac/desktop dev:hot",
    "desktop:build": "pnpm --filter @yaac/desktop build",
    "desktop:package": "pnpm --filter @yaac/desktop app:build",
    "desktop:install": "pnpm --filter @yaac/desktop app:install",
    "prepublishOnly": "pnpm build",
    "modularity": "tsx scripts/modularity.ts",
    "depcruise": "depcruise"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/claude-code": "2.1.111",
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/node-ws": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@kubernetes/client-node": "catalog:",
    "@lydell/node-pty": "catalog:",
    "@openai/codex": "0.146.0",
    "commander": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "simple-git": "catalog:",
    "smol-toml": "catalog:",
    "ws": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@vitest/coverage-v8": "4.1.3",
    "@yaac/auth-daemon": "workspace:*",
    "@yaac/cli": "workspace:*",
    "@yaac/desktop": "workspace:*",
    "@yaac/frontend": "workspace:*",
    "@yaac/server": "workspace:*",
    "@yaac/shared": "workspace:*",
    "@yaac/test-utils": "workspace:*",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.2.0",
    "globals": "17.4.0",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.1",
    "vitest": "4.1.3"
  }
}
