{
  "name": "@bsklaroff/yaac",
  "version": "0.0.5",
  "description": "Agent sandbox manager",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsklaroff/yaac.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "bin": {
    "yaac": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsx scripts/check-cli-externals.ts && pnpm --filter @yaac/frontend build && rm -rf dist/frontend && cp -r packages/frontend/dist dist/frontend && cp -r dockerfiles k8s dist/ && rm -rf dist/drizzle && cp -r packages/server/drizzle dist/drizzle && rm -rf dist/k8s/proxy/node_modules dist/k8s/proxy/test dist/k8s/relay/node_modules && tsx scripts/write-build-id.ts",
    "dev": "tsx packages/cli/src/cli.ts",
    "watch": "tsx watch --clear-screen=false --include 'packages/**/src/**' --include 'packages/server/drizzle/**' --include 'dockerfiles/**' --include 'k8s/**' --include package.json --include 'packages/*/package.json' --include pnpm-lock.yaml --include tsup.config.ts --include 'packages/frontend/vite.config.ts' --exclude '**/node_modules/**' --exclude 'k8s/proxy/test/**' --exclude 'packages/desktop/**' scripts/dev-watch.ts",
    "lint": "tsc --noEmit && tsc --noEmit -p packages/frontend/tsconfig.json && eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project 'unit:*'",
    "test:e2e": "vitest run --project e2e",
    "test:e2e-cli": "vitest run test/e2e-cli",
    "test:api": "vitest run --project api",
    "test:watch": "vitest",
    "frontend:dev": "pnpm --filter @yaac/frontend dev",
    "frontend:build": "pnpm --filter @yaac/frontend build",
    "desktop:dev": "pnpm --filter @yaac/desktop dev",
    "desktop:hot": "pnpm --filter @yaac/desktop dev:hot",
    "desktop:build": "pnpm --filter @yaac/desktop build",
    "desktop:package": "pnpm --filter @yaac/desktop app:build",
    "desktop:install": "pnpm --filter @yaac/desktop app:install",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.111",
    "@electric-sql/pglite": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/node-ws": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@lydell/node-pty": "catalog:",
    "@openai/codex": "0.121.0",
    "commander": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "simple-git": "catalog:",
    "smol-toml": "catalog:",
    "ws": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@yaac/auth-daemon": "workspace:*",
    "@yaac/cli": "workspace:*",
    "@yaac/desktop": "workspace:*",
    "@yaac/frontend": "workspace:*",
    "@yaac/server": "workspace:*",
    "@yaac/shared": "workspace:*",
    "@yaac/test-utils": "workspace:*",
    "eslint": "10.2.0",
    "globals": "17.4.0",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.1",
    "vitest": "4.1.3"
  }
}
