{
  "name": "@yaac/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "imports": {
    "#*": "./src/*.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup && electron .",
    "dev:isolated": "bash scripts/dev-app.sh",
    "app:build": "pnpm -w build && tsup && tsx scripts/stage-server.ts && electron-builder --config electron-builder.yml",
    "app:install": "pnpm app:build && tsx scripts/install-app.ts"
  },
  "dependencies": {
    "@yaac/shared": "workspace:*",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "tsup": "catalog:",
    "tsx": "catalog:"
  }
}
