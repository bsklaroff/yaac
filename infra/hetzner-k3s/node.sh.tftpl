#!/bin/bash
# User data for every node (main.tf): stock containerd from apt, set up the
# way yaac's gVisor installer expects (docs/cluster-setup.md "Bring your own
# cluster"), then the k3s agent on a worker. k3s runs against this
# containerd rather than its embedded one, which would rewrite its config on
# every start and drop the installer's runtime entries.
#
# The control node gets no k3s here. It installs the NFS server behind the
# shared claim, Tailscale, and yaac for the `yaac` user, while tofu's
# provisioner (control.sh.tftpl) installs the k3s server once containerd is
# up. Output goes to /var/log/yaac-node.log.
set -euxo pipefail
exec > >(tee -a /var/log/yaac-node.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt="apt-get -y -o DPkg::Lock::Timeout=600"
$apt update
%{ if role == "server" ~}
$apt install containerd curl git jq acl podman nfs-kernel-server libgomp1 build-essential
%{ else ~}
$apt install containerd curl
%{ endif ~}

# The private network's address, which k3s and Calico use. cloud-init
# configures only the public interface, and Hetzner's hot-plug rule misses
# a private one attached while the server boots, so the interface is
# brought up from the metadata service's record of it. On a server the
# autoscaler creates, that record can trail first boot by a few seconds.
# `networkctl reload` touches only the new interface; `netplan apply`
# would reconfigure the public one too and can drop it.
for _ in $(seq 60); do
  mac=$(curl -fsS http://169.254.169.254/hetzner/v1/metadata/private-networks | awk '/mac_address:/ { print $2; exit }' || true)
  [ -n "$mac" ] && break
  sleep 5
done
[ -n "$mac" ] || { echo "the metadata service lists no private network" >&2; exit 1; }
umask 077
printf 'network:\n  version: 2\n  ethernets:\n    private:\n      match: { macaddress: "%s" }\n      dhcp4: true\n' "$mac" > /etc/netplan/60-yaac-private.yaml
umask 022
netplan generate
networkctl reload
for _ in $(seq 60); do
  node_ip=$(ip -4 -o addr show scope global | awk -v net='${subnet_prefix}.' 'index($4, net) == 1 { sub(/\/.*/, "", $4); print $4; exit }')
  [ -n "$node_ip" ] && break
  sleep 5
done
[ -n "$node_ip" ] || { echo "no address in ${subnet_prefix}.0/24 on any interface" >&2; exit 1; }

# The gVisor installer appends its runtimes to this file and needs
# config_path to name certs.d, where yaac's registries write hosts.toml.
# The kubelet runs with the systemd cgroup driver, so runc must too.
# containerd 1.7 writes SystemdCgroup = false; 2.x leaves it out.
cfg=/etc/containerd/config.toml
mkdir -p /etc/containerd/certs.d
containerd config default > "$cfg"
sed -i -E "s#^([[:space:]]*config_path[[:space:]]*=[[:space:]]*)(''|\"\")#\1'/etc/containerd/certs.d'#" "$cfg"
if grep -qE '^[[:space:]]*SystemdCgroup[[:space:]]*=' "$cfg"; then
  sed -i -E 's/^([[:space:]]*SystemdCgroup[[:space:]]*=[[:space:]]*)false/\1true/' "$cfg"
else
  sed -i -E '/runtimes\.runc\.options[]]$/a SystemdCgroup = true' "$cfg"
fi
grep -qE '^[[:space:]]*SystemdCgroup[[:space:]]*=[[:space:]]*true' "$cfg"
grep -qF "'/etc/containerd/certs.d'" "$cfg"
systemctl enable containerd
systemctl restart containerd

%{ if role == "server" ~}
useradd -m -u 1000 -s /bin/bash yaac

# The shared claim's backing store: a volume, so it outlives this server.
# NFSv4 only: v3 also needs rpcbind and mountd, on ports no policy
# excludes. no_root_squash, because the CSI driver creates each claim's
# directory as root and install's binder pod chowns it to uid 1000.
dev='${nfs_device}'
for _ in $(seq 120); do [ -e "$dev" ] && break; sleep 5; done
mkdir -p '${nfs_export}'
echo "$dev ${nfs_export} ext4 defaults,nofail,discard 0 2" >> /etc/fstab
mount '${nfs_export}'
mkdir -p /etc/nfs.conf.d /etc/exports.d
printf '[nfsd]\nvers3=n\n' > /etc/nfs.conf.d/yaac.conf
# No delegations: nfsd grants them only through file leases. With directory
# delegations, a directory one node created could stay invisible to another
# indefinitely, and a mkdir could create its directory yet fail with EEXIST.
# Without them, the claim's actimeo=1 bounds staleness at about a second.
echo 'fs.leases-enable = 0' > /etc/sysctl.d/90-yaac-nfs.conf
sysctl -p /etc/sysctl.d/90-yaac-nfs.conf
echo '${nfs_export} ${subnet_prefix}.0/24(rw,sync,no_subtree_check,no_root_squash)' > /etc/exports.d/yaac.exports
systemctl enable nfs-server
systemctl restart nfs-server

curl -fsSL https://tailscale.com/install.sh | sh

# The provisioner waits for this before it installs the k3s server.
mkdir -p /var/lib/yaac
touch /var/lib/yaac/containerd.ready

# yaac drives the rootful podman engine on Linux (docs/cluster-setup.md
# "Linux: rootful podman"). The drop-in gives the yaac user the socket
# through a group, which survives reboots where a setfacl on /run would not.
groupadd -f podman
usermod -aG podman yaac
mkdir -p /etc/systemd/system/podman.socket.d
cat > /etc/systemd/system/podman.socket.d/yaac.conf <<'EOF'
[Socket]
SocketMode=0660
SocketGroup=podman
ExecStartPost=/bin/sh -c 'chgrp podman /run/podman && chmod 0750 /run/podman'
EOF
systemctl daemon-reload
systemctl enable podman.socket
systemctl restart podman.socket

# k3s's kubectl reads its root-only config unless KUBECONFIG says
# otherwise. k3s runs kube-proxy inside its own process, where the CNI
# gate cannot see it (docs/cluster-setup.md "The CNI gate").
cat > /home/yaac/.yaac-hetzner.env <<'EOF'
export KUBECONFIG=$HOME/.kube/config
export YAAC_KUBE_PROXY_EXTERNAL=1
EOF
echo '. ~/.yaac-hetzner.env' >> /home/yaac/.bashrc
chown yaac:yaac /home/yaac/.yaac-hetzner.env

# Node comes from nvm, not apt: Ubuntu's build lacks the TypeScript type
# stripping the frontend build needs (docs/install-from-source.md
# "Linux (Debian/Ubuntu)").
sudo -iu yaac bash -exo pipefail <<'EOS'
curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.6/install.sh | bash
export NVM_DIR="$HOME/.nvm"
. "$NVM_DIR/nvm.sh"
git clone '${yaac_repo}' ~/yaac
cd ~/yaac
git checkout '${yaac_ref}'
nvm install
nvm alias default "$(cat .nvmrc)"
# The exact pnpm package.json pins, so pnpm never fetches one itself: the
# repo's minimumReleaseAge refuses a pin newer than its cutoff.
npm install -g "pnpm@$(node -p 'require("./package.json").packageManager.split("@")[1]')"
CI=true pnpm install --frozen-lockfile
pnpm build
npm install -g .
EOS

touch /var/lib/yaac/yaac.ready
%{ else ~}
mkdir -p /etc/rancher/k3s
umask 077
cat > /etc/rancher/k3s/config.yaml <<'EOF'
${k3s_config}
EOF
echo "node-ip: $node_ip" >> /etc/rancher/k3s/config.yaml
umask 022
curl -fsSL '${k3s_install_url}' | INSTALL_K3S_VERSION='${k3s_version}' INSTALL_K3S_EXEC=agent sh -
%{ endif ~}
