#!/bin/bash
# Installs or reconfigures the k3s server on the control node. tofu copies
# this over ssh and runs it whenever its content changes (main.tf), so the
# tokens and the cluster's prerequisite manifests never sit in the node's
# user data, and a change to them reaches the running cluster. Every step
# is idempotent; re-running the k3s installer restarts the server, which
# leaves running pods alone.
set -euo pipefail

for _ in $(seq 180); do [ -f /var/lib/yaac/containerd.ready ] && break; sleep 5; done
[ -f /var/lib/yaac/containerd.ready ] || { echo "the node bootstrap never finished; see /var/log/yaac-node.log" >&2; exit 1; }

umask 077
mkdir -p /etc/rancher/k3s /var/lib/rancher/k3s/server/manifests
cat > /etc/rancher/k3s/config.yaml <<'EOF'
${k3s_config}
EOF
# k3s applies every file in this directory, and re-applies one that changes.
cat > /var/lib/rancher/k3s/server/manifests/yaac-prereqs.yaml <<'EOF'
${manifests}
EOF
umask 022

curl -fsSL '${k3s_install_url}' | INSTALL_K3S_VERSION='${k3s_version}' INSTALL_K3S_EXEC=server sh -

for _ in $(seq 60); do [ -f /etc/rancher/k3s/k3s.yaml ] && break; sleep 2; done
install -D -o yaac -g yaac -m 600 /etc/rancher/k3s/k3s.yaml /home/yaac/.kube/config

%{ if tailscale_auth_key != "" ~}
# A spent or expired key leaves the node off the tailnet; `tailscale up`
# joins it later.
tailscale status >/dev/null 2>&1 \
  || tailscale up --auth-key='${tailscale_auth_key}' --hostname='${host_name}' --ssh \
  || echo "yaac: tailscale up failed; run 'tailscale up --ssh' to join the tailnet" >&2
%{ endif ~}
